<%= link_to book_path(book), id: dom_id(book), class: "card bg-surface shadow-xs hover:shadow-xl transition-all duration-300 rounded-2xl border border-border/80 overflow-hidden group flex flex-col h-full focus:outline-none focus:ring-2 focus:ring-primary/50 cursor-pointer" do %>
  <%# Compact Full Cover Image Figure %>
  <figure class="relative h-44 sm:h-48 w-full overflow-hidden bg-background m-0 shrink-0 border-b border-border/40">
    <% if book.cover_image.present? %>
      <img src="<%= book.cover_image %>" alt="<%= book.title %>" class="h-full w-full object-cover object-center group-hover:scale-105 transition-transform duration-500">
    <% else %>
      <div class="flex h-full w-full flex-col items-center justify-center bg-background text-content-muted p-3 text-center border border-dashed border-border/60">
        <svg class="h-8 w-8 mb-1 opacity-50 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <span class="text-xs font-semibold text-content-muted">No Cover</span>
      </div>
    <% end %>

    <%# Published Year Badge %>
    <% if book.published_at.present? %>
      <div class="absolute top-2.5 right-2.5 z-10">
        <span class="badge badge-neutral badge-sm shadow-xs backdrop-blur-md bg-surface/90 text-content font-semibold border-border/80">
          <%= book.published_at.strftime('%Y') %>
        </span>
      </div>
    <% end %>
  </figure>

  <%# Card Body %>
  <div class="card-body p-4 flex flex-col justify-between flex-1">
    <div>
      <h3 class="card-title title-sm text-base font-bold text-content mb-1 line-clamp-2 leading-snug group-hover:text-primary transition-colors">
        <%= book.title %>
      </h3>
      <p class="text-xs text-content-subtle font-medium truncate mb-2">
        <%= book.author.presence || 'Unknown Author' %>
      </p>
    </div>

    <div class="pt-3 border-t border-border/50">
      <%# Rating Row %>
      <div class="flex items-center justify-between text-xs">
        <div class="flex items-center gap-1">
          <svg class="w-4 h-4 text-warning fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
          <span class="font-bold text-content"><%= book.average_rating %></span>
        </div>
        <span class="text-content-muted">
          <%= book.reviews_count %> <%= "review".pluralize(book.reviews_count) %>
        </span>
      </div>
    </div>
  </div>
<% end %>
