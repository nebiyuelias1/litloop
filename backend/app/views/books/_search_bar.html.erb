<div data-controller="search" role="search" class="relative group search-hero">
  <div class="search-container">
    <div
      class="
        absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none
      ">
      <svg
        aria-hidden="true"
        class="
          h-6 w-6 text-content-muted group-focus-within:text-primary transition-colors
        "
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
    <input
      type="search"
      autocomplete="off"
      enterkeyhint="search"
      aria-label="<%= t("library.search_label") %>"
      placeholder="<%= t("search_bar_placeholder") %>"
      class="
        search-input block w-full pr-4 bg-surface text-content
        placeholder:text-content-muted focus:outline-none shadow-sm transition-all
        sm:text-lg
      "
      data-search-target="input"
      data-action="input->search#perform">

    <turbo-frame
      id="search_results"
      data-search-target="results"
      class="absolute z-50 w-full mt-2">
    </turbo-frame>

    <div
      data-search-target="loader"
      class="
        hidden absolute z-50 w-full mt-2 bg-surface border border-border rounded-2xl
        shadow-lg p-4 text-center text-sm text-content-muted
      "
      role="status">
      <%= t("library.searching") %>
    </div>
  </div>
</div>
