<% content_for :title, @book.title %>
<% author_name = @book.author.presence || t("unknown_author") %>
<% book_lang = book_lang_attribute(@book) %>
<% content_for :og_title, t(".og_title", title: @book.title, author: author_name) %>
<% content_for :og_description, truncate(@book.description.to_s.strip, length: 160) %>
<% content_for :og_url, book_url(@book) %>
<% if @book.cover_image.present? %>
  <% content_for :og_image, cover_book_url(@book) %>
<% end %>

<%
  star_path = "M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
  average = @book.average_rating
  colophon_rows = [
    [t(".publisher"), @book.publisher.presence],
    [t(".published"), (l(@book.published_at, format: :month_year) if @book.published_at)],
    [t(".language"), book_language_name(@book)],
    [t("page_count"), (number_with_delimiter(@book.page_count) if @book.page_count.present?)],
    [t(".isbn"), @book.isbn.presence]
  ].select { |_, value| value.present? }

  colophon = capture do
%>
  <% if colophon_rows.any? %>
    <dl class="rounded-2xl border border-border bg-surface px-4 text-sm divide-y divide-border">
      <% colophon_rows.each do |label, value| %>
        <div class="flex items-baseline justify-between gap-4 py-2.5">
          <dt class="text-content-muted shrink-0"><%= label %></dt>
          <dd class="font-medium text-content text-right tabular-nums min-w-0 break-words"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  <% end %>
<% end %>

<article class="mx-auto max-w-5xl sm:pt-4">
  <div class="grid grid-cols-[6.5rem_minmax(0,1fr)] sm:grid-cols-[10rem_minmax(0,1fr)] md:grid-cols-[15rem_minmax(0,1fr)] gap-x-5 sm:gap-x-8 md:gap-x-12">

    <%# Cover + colophon: the catalogue card %>
    <aside class="md:row-span-2">
      <div class="md:sticky md:top-24 space-y-6">
        <div class="relative aspect-[2/3] w-full overflow-hidden rounded-xl border border-border bg-background">
          <%# Bookplate monogram sits beneath the image; image-fallback hides a broken img on error %>
          <%= render "shared/book_cover_fallback", book: @book, size_class: "text-5xl md:text-7xl" %>
          <% if @book.cover_image.present? %>
            <img
              src="<%= @book.cover_image %>"
              alt="<%= t(".cover_alt", title: @book.title) %>"
              data-controller="image-fallback"
              data-action="error->image-fallback#fail"
              class="absolute inset-0 w-full h-full object-cover">
          <% end %>
        </div>
        <div class="hidden md:block"><%= colophon %></div>
      </div>
    </aside>

    <%# Title page %>
    <header class="min-w-0 self-start">
      <h1 <%= tag.attributes(lang: book_lang) %> class="font-serif font-normal text-content text-[1.625rem] sm:text-4xl md:text-[2.75rem] leading-[1.1] tracking-[-0.01em] text-balance break-words [text-box:trim-start_cap_alphabetic]">
        <%= @book.title %>
      </h1>
      <p class="mt-2 sm:mt-3 text-base sm:text-lg text-content-subtle">
        <%= t(".by_author_html", author: tag.span(author_name, class: "text-content font-medium", lang: (book_lang if @book.author.present?))) %>
      </p>

      <div class="mt-3 sm:mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm">
        <% if @book.reviews_count.to_i > 0 || average.to_f > 0 %>
          <% halves = (average.to_f * 2).round %>
          <span class="flex text-accent" aria-hidden="true">
            <% 5.times do |i| %>
              <% if halves >= 2 * (i + 1) %>
                <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path d="<%= star_path %>" /></svg>
              <% elsif halves == 2 * i + 1 %>
                <span class="relative w-4 h-4">
                  <svg class="absolute inset-0 w-4 h-4 text-content-muted/30" viewBox="0 0 20 20" fill="currentColor"><path d="<%= star_path %>" /></svg>
                  <svg class="absolute inset-0 w-4 h-4 [clip-path:inset(0_50%_0_0)]" viewBox="0 0 20 20" fill="currentColor"><path d="<%= star_path %>" /></svg>
                </span>
              <% else %>
                <svg class="w-4 h-4 text-content-muted/30" viewBox="0 0 20 20" fill="currentColor"><path d="<%= star_path %>" /></svg>
              <% end %>
            <% end %>
          </span>
          <span class="inline-flex items-center gap-x-2 whitespace-nowrap">
            <span class="font-semibold text-content tabular-nums"><span class="sr-only"><%= t(".average_rating") %> </span><%= average %></span>
            <span class="text-content-muted" aria-hidden="true">·</span>
            <a href="#reviews" class="text-content-subtle underline decoration-border underline-offset-4 hover:text-accent hover:decoration-accent/40 transition-colors"><%= t(".reviews_count", count: @book.reviews_count) %></a>
          </span>
        <% else %>
          <span class="text-content-muted"><%= t(".not_yet_rated") %></span>
        <% end %>
      </div>

      <% if @book.tags.any? %>
        <ul class="mt-4 sm:mt-5 hidden sm:flex flex-wrap gap-2" aria-label="<%= t(".tags") %>">
          <% @book.tags.each do |tag| %>
            <li class="rounded-lg border border-border bg-surface px-2 py-1 text-xs font-medium text-content-subtle"><%= tag.name %></li>
          <% end %>
        </ul>
      <% end %>
    </header>

    <%# Reading column %>
    <div class="col-span-2 md:col-span-1 md:col-start-2 min-w-0 mt-6 sm:mt-8 md:mt-10 space-y-10 sm:space-y-12">

      <% if @book.tags.any? %>
        <ul class="flex sm:hidden flex-wrap gap-2 -mt-2" aria-label="<%= t(".tags") %>">
          <% @book.tags.each do |tag| %>
            <li class="rounded-lg border border-border bg-surface px-2 py-1 text-xs font-medium text-content-subtle"><%= tag.name %></li>
          <% end %>
        </ul>
      <% end %>

      <div class="md:hidden"><%= colophon %></div>

      <% if @book.description.present? %>
        <section aria-labelledby="about-heading">
          <h2 id="about-heading" class="title text-xl font-bold text-content mb-3"><%= t(".about") %></h2>
          <div <%= tag.attributes(lang: book_lang) %> class="max-w-[65ch] text-base leading-relaxed text-content [&>p+p]:mt-4">
            <%= simple_format(@book.description) %>
          </div>
        </section>
      <% end %>

      <%# Clubs reading this book: discovery leads to a real read %>
      <% if @club_reads.any? %>
        <section aria-labelledby="club-reads-heading">
          <h2 id="club-reads-heading" class="title text-xl font-bold text-content mb-4"><%= t(".club_reads") %></h2>
          <ul class="space-y-3">
            <% @club_reads.each do |read| %>
              <% upcoming = read.meetup_time >= Time.current %>
              <li>
                <%= link_to book_club_book_read_path(read.book_club, read),
                    class: "group flex items-center gap-4 rounded-2xl border border-border bg-surface p-3 sm:p-4 hover:border-accent/40 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" do %>
                  <div class="flex w-14 shrink-0 flex-col items-center rounded-xl bg-background py-2 <%= upcoming ? 'text-accent' : 'text-content-subtle' %>">
                    <span class="text-[0.6875rem] font-semibold uppercase tracking-wider leading-none"><%= l(read.meetup_time, format: :month_short) %></span>
                    <span class="mt-1 font-serif text-2xl leading-none tabular-nums"><%= read.meetup_time.day %></span>
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="text-xs font-bold uppercase tracking-wider text-accent truncate"><%= read.book_club.name %></p>
                    <p class="mt-1 text-sm text-content-subtle line-clamp-2">
                      <%= l(read.meetup_time, format: :club_read) %>
                      <% if read.meetup_location.present? %>
                        <span aria-hidden="true">·</span> <%= read.meetup_location %>
                      <% end %>
                    </p>
                  </div>
                  <% if upcoming %>
                    <span class="hidden sm:inline-flex shrink-0 rounded-lg border border-accent/40 bg-accent/10 px-2 py-1 text-xs font-medium text-accent"><%= t(".upcoming") %></span>
                  <% end %>
                  <svg class="w-5 h-5 shrink-0 text-content-muted group-hover:text-accent group-hover:translate-x-0.5 transition" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M7.21 14.77a.75.75 0 01.02-1.06L11.168 10 7.23 6.29a.75.75 0 111.04-1.08l4.5 4.25a.75.75 0 010 1.08l-4.5 4.25a.75.75 0 01-1.06-.02z" clip-rule="evenodd" />
                  </svg>
                <% end %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>

      <%# Your take: rating + review %>
      <section aria-labelledby="your-take-heading">
        <% if user_signed_in? %>
          <div class="rounded-2xl border border-border bg-surface p-5 sm:p-6">
            <div
              class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3"
              data-controller="rating"
              data-rating-book-id-value="<%= @book.id %>"
              data-rating-current-value="<%= @user_score %>"
              data-rating-saved-text-value="<%= t(".rating_saved") %>"
              data-rating-failed-text-value="<%= t(".rating_failed") %>">
              <div>
                <h2 id="your-take-heading" class="title text-xl font-bold text-content"><%= t(".have_you_read") %></h2>
                <p class="text-sm text-content-subtle mt-1"><%= t(".rate_prompt") %></p>
              </div>
              <%= render "shared/star_rating",
                  score: @user_score,
                  legend: t(".your_rating"),
                  input_data: { rating_target: "input", action: "change->rating#rate" } %>
            </div>

            <%= form_with(model: [@book, Review.new], class: "mt-5 pt-5 border-t border-border space-y-3") do |f| %>
              <%= f.label :body, t(".write_review"), class: "block text-sm font-medium text-content" %>
              <%= f.text_area :body,
                    rows: 4,
                    required: true,
                    placeholder: t(".review_placeholder"),
                    class: "w-full rounded-xl border border-border bg-surface px-4 py-3 text-base sm:text-sm leading-relaxed text-content placeholder:text-content-muted focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition resize-y min-h-[112px]" %>
              <div class="flex justify-end">
                <%= f.submit t(".post_review"), class: "btn-primary cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:scale-[0.98] transition" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="rounded-2xl border border-border bg-surface p-5 sm:p-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <div>
              <h2 id="your-take-heading" class="title text-xl font-bold text-content"><%= t(".read_this_book") %></h2>
              <p class="text-sm text-content-subtle mt-1"><%= t(".sign_in_prompt") %></p>
            </div>
            <%= link_to t(".sign_in_cta"), new_user_session_path,
                class: "btn-primary justify-center shrink-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" %>
          </div>
        <% end %>
      </section>

      <%# Reviews %>
      <section id="reviews" aria-labelledby="reviews-heading" class="scroll-mt-24">
        <div class="flex items-baseline justify-between gap-4">
          <h2 id="reviews-heading" class="title text-xl font-bold text-content"><%= t(".reviews") %></h2>
          <span class="text-sm text-content-subtle tabular-nums"><%= t(".reviews_count", count: @book.reviews_count) %></span>
        </div>

        <% if @reviews.any? %>
          <ol class="mt-5 space-y-4">
            <% @reviews.each do |review| %>
              <% score = @review_scores[review.user_id].to_i %>
              <% liked = @liked_review_ids.include?(review.id) %>
              <% own = user_signed_in? && review.user_id == current_user.id %>
              <li>
                <article class="rounded-2xl border bg-surface p-5 sm:p-6 <%= own ? 'border-primary/25' : 'border-border' %>" aria-label="<%= t(".review_by", name: review.user.to_s) %>">
                  <header class="flex items-center gap-3">
                    <%= render "shared/avatar",
                        user: review.user,
                        classes: "w-10 h-10 shrink-0 bg-background text-primary text-sm font-semibold ring-1 ring-border" %>
                    <div class="min-w-0 flex-1">
                      <div class="flex items-center gap-2 min-w-0">
                        <span class="text-sm font-semibold text-content truncate"><%= review.user.to_s %></span>
                        <% if own %>
                          <span class="shrink-0 rounded-md bg-background px-1.5 py-0.5 text-[0.6875rem] font-semibold uppercase tracking-wider text-primary"><%= t(".you") %></span>
                        <% end %>
                      </div>
                      <div class="mt-1 flex items-center gap-2 text-xs text-content-muted">
                        <% if score > 0 %>
                          <span class="flex text-accent" role="img" aria-label="<%= t(".rated_out_of_5", score: score) %>">
                            <% 5.times do |i| %>
                              <svg class="w-3.5 h-3.5 <%= i < score ? '' : 'text-content-muted/30' %>" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="<%= star_path %>" /></svg>
                            <% end %>
                          </span>
                          <span aria-hidden="true">·</span>
                        <% end %>
                        <time datetime="<%= review.created_at.iso8601 %>" title="<%= l(review.created_at, format: :long) %>"><%= t(".time_ago", time: time_ago_in_words(review.created_at)) %></time>
                      </div>
                    </div>
                  </header>

                  <div class="mt-4 max-w-[65ch]">
                    <%= render "shared/collapsible_text",
                        text: review.body,
                        max_lines: 6,
                        classes: "text-base sm:text-[0.9375rem] leading-relaxed text-content break-words" %>
                  </div>

                  <footer class="mt-4 -mb-1 flex items-center text-sm">
                    <% if user_signed_in? %>
                      <div
                        data-controller="review-like"
                        data-review-like-review-id-value="<%= review.id %>"
                        data-review-like-book-id-value="<%= @book.id %>"
                        data-review-like-liked-value="<%= liked %>"
                        data-review-like-one-text-value="<%= t(".likes.one") %>"
                        data-review-like-other-text-value="<%= t(".likes.other") %>">
                        <button
                          type="button"
                          data-action="click->review-like#toggle"
                          aria-pressed="<%= liked %>"
                          class="-ml-2 inline-flex min-h-9 items-center gap-1.5 rounded-lg px-2 text-content-subtle hover:bg-background hover:text-content transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-primary active:scale-95">
                          <span data-review-like-target="icon" class="transition-colors <%= liked ? 'text-accent' : 'text-content-muted' %>">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-[1.125rem] h-[1.125rem]" aria-hidden="true">
                              <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
                            </svg>
                          </span>
                          <span data-review-like-target="count" class="font-medium tabular-nums"><%= review.review_likes_count %></span>
                          <span data-review-like-target="text"><%= t(".likes", count: review.review_likes_count) %></span>
                          <span class="sr-only">, <%= t(".like_review_by", name: review.user.to_s) %></span>
                        </button>
                      </div>
                    <% else %>
                      <div class="inline-flex min-h-9 items-center gap-1.5 text-content-muted">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-[1.125rem] h-[1.125rem]" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                        </svg>
                        <span class="font-medium tabular-nums"><%= review.review_likes_count %></span>
                        <span><%= t(".likes", count: review.review_likes_count) %></span>
                      </div>
                    <% end %>
                  </footer>
                </article>
              </li>
            <% end %>
          </ol>
        <% else %>
          <p class="mt-5 rounded-2xl border border-dashed border-border px-5 py-8 text-center text-sm text-content-subtle"><%= t(".no_reviews") %></p>
        <% end %>
      </section>
    </div>
  </div>
</article>
