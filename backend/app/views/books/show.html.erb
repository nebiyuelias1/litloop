<% content_for :title, @book.title %>
<% content_for :og_title, "#{@book.title} by #{@book.author.presence || "Unknown"}" %>
<% content_for :og_description, truncate(@book.description.to_s.strip, length: 160) %>
<% content_for :og_url, book_url(@book) %>
<% if @book.cover_image.present? %>
  <% content_for :og_image, cover_book_url(@book) %>
<% end %>

<%# Catalogue entry for one book: everything flat on the Vellum ground, sections
    separated by deckle-edge rules — the same document grammar as the read page %>
<div class="max-w-4xl mx-auto">
  <nav class="mb-6 sm:mb-8">
    <%= link_to books_path, class: "inline-flex items-center gap-1 text-sm font-medium text-content-muted hover:text-accent transition-colors group focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded-md" do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 group-hover:-translate-x-0.5 transition-transform" aria-hidden="true">
        <path d="M19 12H5m6.5 6.5L5 12l6.5-6.5" />
      </svg>
      <%= t("back_to_library", default: "Back to Library") %>
    <% end %>
  </nav>

  <%# Catalogue header: cover plate beside the record %>
  <div class="flex flex-col sm:flex-row sm:items-start gap-6 md:gap-10">
    <div class="w-40 sm:w-48 md:w-64 shrink-0">
      <% if @book.cover_image.present? %>
        <%= image_tag cover_book_path(@book),
          alt: @book.title,
          loading: "lazy",
          class: "w-full aspect-[2/3] object-cover rounded-xl border border-border" %>
      <% else %>
        <div class="w-full aspect-[2/3] bg-surface rounded-xl border border-border flex flex-col items-center justify-center text-content-muted p-6 text-center">
          <svg class="w-10 h-10 mb-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <span class="text-xs font-medium"><%= t("no_cover_available") %></span>
        </div>
      <% end %>
    </div>

    <div class="flex-1 min-w-0">
      <% if @book.tags.any? %>
        <div class="flex flex-wrap gap-1.5 mb-3">
          <% @book.tags.each do |tag| %>
            <span class="inline-flex items-center rounded-full border border-border bg-surface px-2.5 py-0.5 text-xs font-medium text-content-subtle">
              <%= tag.name %>
            </span>
          <% end %>
        </div>
      <% end %>

      <h1 class="title title-lg text-content font-bold leading-tight"><%= @book.title %></h1>
      <% if @book.title_romanized.present? && @book.title_romanized != @book.title %>
        <p class="mt-1 text-sm text-content-muted truncate"><%= @book.title_romanized %></p>
      <% end %>

      <p class="mt-2 text-lg text-content-subtle">
        <%= t("by_author", author: @book.author.presence || t("unknown_author")) %>
      </p>
      <% if @book.author_romanized.present? && !@book.author_romanized.strip.casecmp?(@book.author.presence || "") %>
        <p class="text-xs text-content-muted mt-0.5"><%= @book.author_romanized %></p>
      <% end %>

      <%# The graded stamp of the catalogue card %>
      <div class="mt-3 flex flex-wrap items-center gap-x-2.5 gap-y-1">
        <div class="flex items-center gap-0.5" aria-hidden="true">
          <% 5.times do |i| %>
            <svg class="w-4 h-4 <%= i < @book.average_rating.round ? "fill-current text-accent" : "fill-current text-content-muted/40" %>" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
            </svg>
          <% end %>
        </div>
        <% if @book.average_rating.positive? %>
          <span class="text-sm font-bold text-content"><%= @book.average_rating %></span>
        <% else %>
          <span class="text-sm font-medium text-content-muted"><%= t("not_rated_yet", default: "Not yet rated") %></span>
        <% end %>
        <% if @book.reviews_count.positive? %>
          <%= link_to t("reviews_count_label", count: @book.reviews_count), "#reviews",
            class: "text-sm font-medium text-content-muted hover:text-accent transition-colors underline decoration-border underline-offset-2" %>
        <% end %>
      </div>
    </div>
  </div>

  <%# Catalogue data: ruled records ledger %>
  <div class="mt-8 py-6 border-y border-border">
    <dl class="grid grid-cols-2 sm:grid-cols-3 gap-x-6 gap-y-5">
      <div class="min-w-0">
        <dt class="text-xs font-medium text-content-muted mb-0.5"><%= t("published_label", default: "Published") %></dt>
        <dd class="text-sm font-bold text-content leading-snug">
          <%= @book.published_at&.strftime("%B %Y") || t("not_set") %>
        </dd>
      </div>
      <div class="min-w-0">
        <dt class="text-xs font-medium text-content-muted mb-0.5"><%= t("publisher_label", default: "Publisher") %></dt>
        <dd class="text-sm font-bold text-content leading-snug truncate"><%= @book.publisher.presence || t("not_set") %></dd>
      </div>
      <div class="min-w-0">
        <dt class="text-xs font-medium text-content-muted mb-0.5"><%= t("language_label", default: "Language") %></dt>
        <dd class="text-sm font-bold text-content leading-snug"><%= @book.language.presence&.upcase || t("not_set") %></dd>
      </div>
      <div class="min-w-0">
        <dt class="text-xs font-medium text-content-muted mb-0.5"><%= t("page_count") %></dt>
        <dd class="text-sm font-bold text-content leading-snug"><%= @book.try(:page_count).presence || t("not_set") %></dd>
      </div>
      <div class="min-w-0">
        <dt class="text-xs font-medium text-content-muted mb-0.5"><%= t("country_of_origin", default: "Country of origin") %></dt>
        <dd class="text-sm font-bold text-content leading-snug">
          <% if @book.country_of_origin.present? %>
            <%= country_display(@book.country_of_origin) %>
          <% elsif @book.enriched_at.present? %>
            <span class="font-normal italic text-content-muted"><%= t("unknown_country", default: "Unknown") %></span>
          <% else %>
            <span class="font-normal text-content-muted"><%= t("not_set") %></span>
          <% end %>
        </dd>
      </div>
      <% if @book.isbn.present? %>
        <div class="min-w-0">
          <dt class="text-xs font-medium text-content-muted mb-0.5"><%= t("isbn_label", default: "ISBN") %></dt>
          <dd class="text-sm font-bold text-content leading-snug"><%= @book.isbn %></dd>
        </div>
      <% end %>
      <% if @book.source.present? || @book.source_url.present? %>
        <div class="min-w-0">
          <dt class="text-xs font-medium text-content-muted mb-0.5"><%= t("source_label", default: "Data source") %></dt>
          <dd class="text-sm font-bold text-content leading-snug truncate">
            <% if @book.source_url.present? %>
              <%= link_to @book.source.presence || t("source_label", default: "Data source"), @book.source_url,
                target: "_blank", rel: "noopener noreferrer",
                class: "text-primary hover:text-accent transition-colors" %>
            <% else %>
              <%= @book.source %>
            <% end %>
          </dd>
        </div>
      <% end %>
    </dl>
  </div>

  <%# About this book %>
  <% enrichment = @book.enrichment || {} %>
  <% desc_actually_changed = enrichment["applied_description"].present? &&
    enrichment["original_description"].present? &&
    enrichment["original_description"].to_s.gsub(/\s+/, " ").strip !=
      @book.description.to_s.gsub(/\s+/, " ").strip %>

  <div class="py-10 border-b border-border">
    <div class="flex items-center justify-between gap-3 mb-3">
      <h2 class="title title-sm text-content font-bold"><%= t("about_the_book") %></h2>
      <% if desc_actually_changed %>
        <span
          class="inline-flex items-center gap-1 shrink-0 rounded-full border border-border bg-surface px-2 py-0.5 text-[11px] font-medium text-content-muted"
          title="<%= t("ai_assisted_title", default: "This description was improved with AI grounding (source-checked, see provenance)") %>">
          <svg class="w-3 h-3 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.7" d="M12 4v4m0 8v4M4 12h4m8 0h4M6.6 6.6l2.2 2.2m6.4 6.4l2.2 2.2m0-12.8l-2.2 2.2m-6.4 6.4l-2.2 2.2" />
          </svg>
          <%= t("ai_assisted", default: "AI-assisted") %>
        </span>
      <% end %>
    </div>

    <% if @book.description.present? %>
      <%= render "shared/collapsible_text",
        text: @book.description,
        max_lines: 8,
        classes: "text-content-subtle leading-relaxed" %>
    <% else %>
      <p class="text-sm text-content-muted"><%= t("no_description_yet", default: "No description yet.") %></p>
    <% end %>

    <% if desc_actually_changed %>
      <details class="mt-4 group">
        <summary
          class="inline-flex items-center gap-1.5 cursor-pointer list-none select-none text-sm font-medium text-content-muted hover:text-content transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded-md">
          <svg class="w-3.5 h-3.5 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
          <%= t("show_previous_description", default: "Show previous description") %>
        </summary>
        <div class="mt-3 pl-4 border-l border-border text-sm text-content-muted space-y-2">
          <%= simple_format(enrichment["original_description"]) %>
          <% if enrichment["model"].present? %>
            <p class="text-xs">
              <%= t("ai_updated_by", model: enrichment["model"], default: "Updated by AI (%{model})") %><%= " — #{enrichment['country_evidence']}" if enrichment["country_evidence"].present? %>
              <% if enrichment["country_source_url"].present? %>
                <%= " — " %><%= link_to t("view_details"), enrichment["country_source_url"],
                  target: "_blank", rel: "noopener noreferrer", class: "text-primary hover:text-accent transition-colors" %>
              <% end %>
            </p>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>

  <%# Circulation: the live reads of this book on real club cards %>
  <div class="py-10 border-b border-border">
    <h2 class="title title-sm text-content font-bold mb-5"><%= t("currently_being_read", default: "Currently Being Read") %></h2>
    <% if @upcoming_reads.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <% @upcoming_reads.each do |read| %>
          <%= render "shared/book_read_card", book_read: read %>
        <% end %>
      </div>
      <% if @past_reads_count.positive? %>
        <p class="mt-4 text-sm text-content-muted">
          <%= t("previously_read_clubs", count: @past_reads_count) %>
        </p>
      <% end %>
    <% else %>
      <div class="py-6 text-center">
        <svg class="w-10 h-10 text-content-muted mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
        </svg>
        <p class="text-sm font-medium text-content"><%= t("no_active_reads", default: "No club is reading this book yet") %></p>
        <p class="text-xs text-content-muted mt-1"><%= t("no_active_reads_hint", default: "When a club schedules it, the meetups will appear here.") %></p>
        <%= link_to t("browse_clubs", default: "Browse book clubs"), book_clubs_path, class: "btn-secondary mt-4" %>
      </div>
      <% if @past_reads_count.positive? %>
        <p class="mt-2 text-center text-sm text-content-muted">
          <%= t("previously_read_clubs", count: @past_reads_count) %>
        </p>
      <% end %>
    <% end %>
  </div>

  <%# Rate it: a sheet like the read page's registration card %>
  <div class="py-10 border-b border-border">
    <% if user_signed_in? %>
      <div
        class="bg-surface border border-border rounded-2xl p-5 sm:p-6"
        data-controller="rating"
        data-rating-book-id-value="<%= @book.id %>"
        data-rating-current-value="<%= @book.user_rating(current_user)&.score || 0 %>">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h2 class="title title-sm text-content font-bold"><%= t("have_you_read_this", default: "Have you read this?") %></h2>
            <p class="text-sm text-content-subtle mt-0.5"><%= t("rate_it_hint", default: "Rate it to share your opinion") %></p>
          </div>
          <div class="flex items-center gap-1">
            <% 5.times do |i| %>
              <button
                type="button"
                data-rating-target="star"
                data-action="click->rating#rate mouseover->rating#hover mouseout->rating#unhover"
                data-rating-value="<%= i + 1 %>"
                aria-label="<%= t("rate_it_hint", default: "Rate it to share your opinion") %>: <%= i + 1 %>"
                class="rounded-full p-1 transition-transform hover:scale-110 active:scale-95 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
                <svg class="w-7 h-7 transition-colors text-content-muted" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.602-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              </button>
            <% end %>
          </div>
        </div>
      </div>
    <% else %>
      <div class="bg-surface border border-border rounded-2xl px-5 py-5 sm:flex sm:items-center justify-between gap-4">
        <div>
          <p class="text-base font-medium text-content"><%= t("rate_cta_title", default: "Read this book?") %></p>
          <p class="text-sm text-content-subtle mt-0.5"><%= t("sign_in_to_rate", default: "Sign in to rate it and add it to your collection.") %></p>
        </div>
        <%= link_to t("sign_in_to_rate_button", default: "Sign In to Rate"), new_user_session_path, class: "btn-primary mt-3 sm:mt-0 shrink-0" %>
      </div>
    <% end %>
  </div>

  <%# Reviews: the marginalia of the catalogue entry %>
  <div id="reviews" class="py-10 scroll-mt-24">
    <div class="flex items-center justify-between gap-3 mb-6">
      <h2 class="title title-sm text-content font-bold"><%= t("reviews_label", default: "Reviews") %></h2>
      <span class="text-sm text-content-muted font-medium"><%= t("reviews_count_label", count: @book.reviews_count) %></span>
    </div>

    <% if user_signed_in? %>
      <%= form_with(model: [@book, Review.new], class: "mb-8") do |f| %>
        <%= f.text_area :body,
          rows: 4,
          placeholder: t("review_placeholder", default: "Share your thoughts about this book..."),
          class: "w-full rounded-lg border border-border bg-surface px-4 py-3 text-sm text-content placeholder:text-content-muted focus:border-primary focus:ring-2 focus:ring-primary/20 focus:outline-none transition-colors resize-y min-h-[100px]" %>
        <div class="flex justify-end mt-3">
          <%= f.submit t("post_review", default: "Post Review"), class: "btn-primary cursor-pointer" %>
        </div>
      <% end %>
    <% else %>
      <div class="mb-8 px-5 py-4 bg-surface border border-border rounded-2xl flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <p class="text-sm text-content-subtle"><%= t("sign_in_to_review", default: "Sign in to share your thoughts on this book.") %></p>
        <%= link_to t("sign_in_to_review_button", default: "Sign In to Review"), new_user_session_path, class: "btn-primary shrink-0" %>
      </div>
    <% end %>

    <% if @reviews.any? %>
      <div class="space-y-8">
        <% @reviews.each do |review| %>
          <article class="flex gap-4">
            <div class="shrink-0">
              <%= render "shared/avatar",
                user: review.user,
                classes: "w-10 h-10 bg-background text-primary text-sm font-semibold ring-1 ring-border" %>
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1.5">
                <span class="text-sm font-semibold text-content"><%= review.user.to_s %></span>
                <span class="text-xs text-content-muted"><%= time_ago_in_words(review.created_at) %> <%= t("ago") %></span>
              </div>
              <div class="text-sm text-content leading-relaxed">
                <%= simple_format(review.body) %>
              </div>
              <div class="mt-2">
                <% if user_signed_in? %>
                  <div
                    data-controller="review-like"
                    data-review-like-review-id-value="<%= review.id %>"
                    data-review-like-book-id-value="<%= @book.id %>"
                    data-review-like-liked-value="<%= review.review_likes.exists?(user_id: current_user.id) %>">
                    <button
                      type="button"
                      data-action="click->review-like#toggle"
                      class="inline-flex items-center gap-1.5 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary rounded-md">
                      <span data-review-like-target="icon" class="transition-colors text-content-muted hover:text-accent">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true">
                          <path d="M11.645 20.91l-.007-.003-.022-.012a15.247 15.247 0 01-.383-.218 25.18 25.18 0 01-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0112 5.052 5.5 5.5 0 0116.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 01-4.244 3.17 15.247 15.247 0 01-.383.219l-.022.012-.007.004-.003.001a.752.752 0 01-.704 0l-.003-.001z" />
                        </svg>
                      </span>
                      <span data-review-like-target="count" class="text-xs font-semibold text-content"><%= review.review_likes_count %></span>
                      <span data-review-like-target="text" class="text-xs font-medium text-content-muted"><%= review.review_likes_count == 1 ? "like" : "likes" %></span>
                    </button>
                  </div>
                <% else %>
                  <div class="inline-flex items-center gap-1.5">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 text-content-muted" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                    </svg>
                    <span class="text-xs font-semibold text-content"><%= review.review_likes_count %></span>
                    <span class="text-xs font-medium text-content-muted"><%= review.review_likes_count == 1 ? "like" : "likes" %></span>
                  </div>
                <% end %>
              </div>
            </div>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="py-6 text-center">
        <svg class="w-10 h-10 text-content-muted mx-auto mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
        <p class="text-sm text-content-subtle"><%= t("no_reviews_yet", default: "No reviews yet. Be the first to share your thoughts!") %></p>
      </div>
    <% end %>
  </div>
</div>
