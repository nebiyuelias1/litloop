<div id="book_read_rsvp_users" class="flex items-center gap-2">
  <% if rsvp_users.any? %>
    <%= render "shared/avatar_group", users: rsvp_users, limit: 5, size_classes: "w-6 h-6", text_size: "text-[9px]", container_classes: "" %>
    <span class="text-xs text-content-subtle"><%= t("people_going", count: rsvp_users.size) %></span>
    <% if waitlisted_count&.positive? %>
      <span class="text-xs text-violet-700 dark:text-violet-400">· <%= t("people_waitlisted", count: waitlisted_count) %></span>
    <% end %>
  <% else %>
    <span class="text-xs text-content-muted"><%= t("no_rsvps_yet") %></span>
  <% end %>
</div>
