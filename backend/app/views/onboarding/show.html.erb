<% content_for :bare_layout, true %>
<%# Apps: no tab bar; no title bar unless pushed %>
<% if hotwire_native_app? %>
  <div data-controller="bridge--tab-bar" hidden></div>
  <div data-controller="bridge--navigation-bar" hidden></div>
<% end %>
<% content_for :title, t(".title") %>
<%
  stations = %w[gather choose meet reflect]
  station_names = stations.map { |s| t(".stations.#{s}") }
  slides = [
    { key: "welcome", station: nil },
    { key: "gather", station: 0 },
    { key: "choose", station: 1 },
    { key: "meet", station: 2 },
    { key: "reflect", station: 3 }
  ]
  total = slides.size
%>

<style>
  .onb {
    height: 100dvh;
    display: flex;
    flex-direction: column;
    padding-top: env(safe-area-inset-top);
    padding-bottom: env(safe-area-inset-bottom);
  }
  .onb-track {
    flex: 1;
    min-height: 0;
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .onb-track::-webkit-scrollbar { display: none; }
  .onb-track:focus-visible { outline: 2px solid var(--color-primary); outline-offset: -2px; }
  .onb-slide {
    flex: 0 0 100%;
    scroll-snap-align: center;
    scroll-snap-stop: always;
    min-width: 0;
    overflow-y: auto;
    overscroll-behavior-y: contain;
    scrollbar-width: none;
  }
  .onb-slide::-webkit-scrollbar { display: none; }

  /* Short phones (e.g. iPhone SE) */
  @media (max-height: 760px) {
    .onb-hero-ring { max-width: 13.5rem; }
    .onb-fan > * { width: 2.75rem; }
    .onb-picks > li:nth-child(n + 4) { display: none; }
    .onb-review blockquote { -webkit-line-clamp: 3; }
    .onb-body { min-height: 0; }
    .onb-slide-inner { gap: 1rem; padding-top: 1rem; }
  }

  /* Loop indicator */
  .onb-loop__station { fill: var(--color-background); stroke: var(--color-primary); stroke-width: 10; opacity: 0.55; transition: opacity 300ms ease-out; }
  .onb-loop__station[data-reached] { opacity: 1; }
  .onb-loop__marker { transition: opacity 200ms ease-out; }

  /* Welcome ring cover fan */
  .onb-fan > * { transform: rotate(var(--r, 0deg)) translateY(var(--y, 0)); }

  @media (prefers-reduced-motion: reduce) {
    .onb-loop__station, .onb-loop__marker { transition: none; }
    .onb-track { scroll-behavior: auto; }
  }
</style>
<noscript>
  <style>
    [data-onboarding-target="tourBar"] { display: none !important; }
    [data-onboarding-target="finalBar"] { display: block !important; }
  </style>
</noscript>

<div
  class="onb"
  data-controller="onboarding"
  data-onboarding-names-value="<%= ([t(".stations.start")] + station_names).to_json %>"
  data-onboarding-status-template-value="<%= t(".step_status", current: "%{current}", total: total, name: "%{name}") %>">

  <%# Top bar: loop progress, station, Skip, language %>
  <header class="mx-auto flex w-full max-w-5xl items-center justify-between gap-4 px-4 pt-4 sm:px-6">
    <div class="flex items-center gap-3">
      <%= render "onboarding/loop_indicator" %>
      <%# Aligned to the loop, not the ribbon %>
      <span class="-translate-y-1 text-xs font-semibold uppercase tracking-wider text-content-subtle" data-onboarding-target="stationLabel" aria-hidden="true"></span>
    </div>

    <div class="flex items-center gap-1">
      <button type="button" class="rounded-lg px-2 py-2 text-sm font-medium text-content-subtle hover:text-accent transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-primary" data-onboarding-target="skip" data-action="onboarding#skip">
        <%= t(".skip") %>
      </button>
      <%# Skip hides on the last slide; the language menu stays put %>
      <%= render "shared/language_switcher" %>
    </div>
  </header>

  <p class="sr-only" aria-live="polite" data-onboarding-target="status"></p>

  <%# Slides: scroll snap, plus buttons and arrow keys %>
  <div
    class="onb-track"
    tabindex="0"
    role="region"
    aria-roledescription="<%= t(".carousel") %>"
    aria-label="<%= t(".title") %>"
    data-onboarding-target="track"
    data-action="keydown->onboarding#key">

    <% slides.each_with_index do |slide, index| %>
      <section
        id="onboarding-<%= index + 1 %>"
        class="onb-slide"
        role="group"
        aria-roledescription="<%= t(".slide") %>"
        aria-label="<%= t(".slide_label", current: index + 1, total: total) %>"
        data-onboarding-target="slide">
        <div class="onb-slide-inner mx-auto grid min-h-full w-full max-w-5xl grid-rows-[1fr_auto] items-center gap-6 px-6 pb-4 pt-6 lg:grid-cols-2 lg:grid-rows-1 lg:gap-16 lg:px-10">
          <div class="flex h-full min-h-0 items-center justify-center">
            <% case slide[:key] %>
            <% when "welcome" %>
              <div class="onb-hero-ring relative aspect-square w-full max-w-[17rem] sm:max-w-[20rem]">
                <svg class="absolute inset-[12%] h-[76%] w-[76%]" viewBox="0 0 200 200" aria-hidden="true">
                  <circle cx="100" cy="100" r="96" fill="none" stroke="var(--color-border)" stroke-width="1.5" />
                  <path d="M100 4 A96 96 0 0 1 196 100" fill="none" stroke="var(--color-primary)" stroke-width="1.5" stroke-dasharray="2 5" stroke-linecap="round" />
                  <% [[100, 4], [196, 100], [100, 196], [4, 100]].each do |(cx, cy)| %>
                    <circle cx="<%= cx %>" cy="<%= cy %>" r="5" fill="var(--color-primary)" stroke="var(--color-background)" stroke-width="3" />
                  <% end %>
                  <circle cx="100" cy="4" r="7" fill="var(--color-accent)" stroke="var(--color-background)" stroke-width="3" />
                </svg>
                <% label_positions = ["left-1/2 top-0 -translate-x-1/2", "right-0 top-1/2 -translate-y-1/2", "bottom-0 left-1/2 -translate-x-1/2", "left-0 top-1/2 -translate-y-1/2"] %>
                <% station_names.each_with_index do |name, i| %>
                  <span class="absolute <%= label_positions[i] %> z-20 rounded-md bg-background px-1.5 text-[0.75rem] font-semibold uppercase tracking-wider <%= i.zero? ? 'text-accent' : 'text-content-subtle' %>"><%= name %></span>
                <% end %>
                <% if @cover_books.any? %>
                  <div class="onb-fan absolute inset-0 flex items-center justify-center" aria-hidden="true">
                    <% fan = [["-12deg", "6px"], ["0deg", "-4px"], ["12deg", "6px"]] %>
                    <% @cover_books.first(3).each_with_index do |book, i| %>
                      <div class="relative -mx-2 aspect-[2/3] w-14 overflow-hidden rounded-md border border-border bg-background ring-4 ring-background sm:w-16 <%= 'z-10' if i == 1 %>" style="--r: <%= fan[i][0] %>; --y: <%= fan[i][1] %>">
                        <%= render "shared/book_cover_fallback", book: book, size_class: "text-2xl" %>
                        <img src="<%= book.cover_image %>" alt="" loading="<%= i.zero? ? 'eager' : 'lazy' %>" data-controller="image-fallback" data-action="error->image-fallback#fail" class="absolute inset-0 h-full w-full object-cover">
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>

            <% when "gather" %>
              <% if @clubs.any? %>
                <ul class="w-full max-w-sm space-y-3">
                  <% @clubs.each_with_index do |club, i| %>
                    <li class="flex items-center gap-3 rounded-2xl border border-border bg-surface p-3.5 <%= %w[ml-0 ml-4 ml-8][i] %>">
                      <%= render "shared/club_avatar", club: club, variant: :row %>
                      <div class="min-w-0 flex-1">
                        <p class="title-sm truncate font-bold text-content"><%= club.name %></p>
                        <p class="mt-0.5 text-xs text-content-subtle"><%= t("member_count", count: club.book_club_members_count) %></p>
                      </div>
                    </li>
                  <% end %>
                </ul>
              <% else %>
                <div class="relative flex aspect-square w-40 items-center justify-center rounded-3xl"><%= render "shared/cover_fallback", icon: "clubs", size_class: "text-6xl" %></div>
              <% end %>

            <% when "choose" %>
              <% if @picks_by_language.any? %>
                <div class="w-full max-w-sm" data-controller="onboarding-picks">
                  <% if @picks_by_language.size > 1 %>
                    <div class="mb-4 flex flex-wrap gap-2" role="group" aria-label="<%= t(".picks_language") %>">
                      <% @picks_by_language.each_key do |code| %>
                        <button
                          type="button"
                          class="rounded-full border px-3 py-1.5 text-sm font-medium transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary aria-pressed:border-primary aria-pressed:bg-primary aria-pressed:text-primary-contrast border-border bg-surface text-content-subtle hover:text-content"
                          aria-pressed="<%= code == @default_pick_language %>"
                          data-onboarding-picks-target="tab"
                          data-lang="<%= code %>"
                          data-action="onboarding-picks#select">
                          <%= t("languages.#{code}", default: code) %>
                        </button>
                      <% end %>
                    </div>
                  <% end %>
                  <% @picks_by_language.each do |code, books| %>
                    <ul class="onb-picks grid grid-cols-3 gap-2.5 <%= 'hidden' unless code == @default_pick_language %>" data-onboarding-picks-target="panel" data-lang="<%= code %>" lang="<%= code %>">
                      <% books.each do |book| %>
                        <li>
                          <div class="relative aspect-[2/3] overflow-hidden rounded-lg border border-border bg-background">
                            <%= render "shared/book_cover_fallback", book: book, size_class: "text-2xl" %>
                            <img src="<%= book.cover_image %>" alt="<%= t("books.show.cover_alt", title: book.title) %>" loading="lazy" data-controller="image-fallback" data-action="error->image-fallback#fail" class="absolute inset-0 h-full w-full object-cover">
                          </div>
                        </li>
                      <% end %>
                    </ul>
                  <% end %>
                  <p class="mt-4 flex items-center gap-2 text-sm text-content-subtle">
                    <svg class="h-5 w-5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                    <%= t(".poll_note") %>
                  </p>
                </div>
              <% else %>
                <div class="relative flex aspect-[2/3] w-36 items-center justify-center rounded-2xl"><%= render "shared/cover_fallback", icon: "library", size_class: "text-6xl" %></div>
              <% end %>

            <% when "meet" %>
              <% if @upcoming_read %>
                <% read = @upcoming_read %>
                <div class="w-full max-w-sm space-y-3">
                  <div class="flex gap-4 rounded-3xl border border-border bg-surface p-4">
                    <div class="flex w-14 shrink-0 flex-col items-center self-start rounded-xl bg-background py-2 text-accent">
                      <span class="text-xs font-semibold uppercase tracking-wider leading-none"><%= l(read.meetup_time, format: :month_short) %></span>
                      <span class="mt-1 font-serif text-2xl leading-none tabular-nums"><%= read.meetup_time.day %></span>
                    </div>
                    <div class="min-w-0 flex-1">
                      <p class="truncate text-xs font-bold uppercase tracking-wider text-accent"><%= read.book_club.name %></p>
                      <p class="title-sm mt-1 line-clamp-2 font-bold text-content"><%= read.book.title %></p>
                      <ul class="mt-2.5 space-y-1.5 text-sm text-content-subtle">
                        <li class="flex items-center gap-2">
                          <svg class="h-4 w-4 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                          <span class="truncate"><%= l(read.meetup_time, format: :club_read) %></span>
                        </li>
                        <% if read.meetup_location.present? %>
                          <li class="flex items-center gap-2">
                            <svg class="h-4 w-4 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" /><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" /></svg>
                            <span class="truncate"><%= read.meetup_location %></span>
                          </li>
                        <% end %>
                        <li class="flex items-center gap-2">
                          <svg class="h-4 w-4 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>
                          <span><%= t(".going", count: read.book_read_rsvps.going.count) %></span>
                        </li>
                      </ul>
                    </div>
                  </div>
                  <% if @question %>
                    <figure class="rounded-2xl border border-border bg-background px-4 py-3.5">
                      <figcaption class="text-xs font-semibold text-content-subtle"><%= t(".question_label") %></figcaption>
                      <blockquote class="mt-1.5 line-clamp-3 font-serif text-base leading-snug text-content"><%= @question.content %></blockquote>
                    </figure>
                  <% end %>
                </div>
              <% else %>
                <div class="relative flex aspect-square w-40 items-center justify-center rounded-3xl"><%= render "shared/cover_fallback", icon: "clubs", size_class: "text-6xl" %></div>
              <% end %>

            <% when "reflect" %>
              <% if @review %>
                <figure class="onb-review w-full max-w-sm rounded-3xl border border-border bg-surface p-5">
                  <% score = @review.book.ratings.find_by(user_id: @review.user_id)&.score.to_i %>
                  <% if score > 0 %>
                    <div class="mb-3 flex text-accent" role="img" aria-label="<%= t("books.show.rated_out_of_5", score: score) %>">
                      <% 5.times do |i| %>
                        <svg class="h-5 w-5 <%= 'text-content-muted/30' unless i < score %>" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" /></svg>
                      <% end %>
                    </div>
                  <% end %>
                  <blockquote class="line-clamp-4 font-serif text-lg leading-snug text-content"><%= @review.body %></blockquote>
                  <figcaption class="mt-4 flex items-center gap-3 border-t border-border pt-4">
                    <%= render "shared/avatar", user: @review.user, classes: "w-9 h-9 bg-background text-primary text-xs font-semibold ring-1 ring-border" %>
                    <div class="min-w-0 text-sm">
                      <p class="truncate font-semibold text-content"><%= @review.user.to_s %></p>
                      <p class="truncate text-content-subtle"><%= t(".review_on", title: @review.book.title) %></p>
                    </div>
                  </figcaption>
                </figure>
              <% else %>
                <div class="relative flex aspect-square w-40 items-center justify-center rounded-3xl"><%= render "shared/cover_fallback", icon: "library", size_class: "text-6xl" %></div>
              <% end %>
            <% end %>
          </div>

          <%# Copy %>
          <div class="mx-auto w-full max-w-sm self-start lg:max-w-md lg:self-center">
            <%= content_tag(index.zero? ? :h1 : :h2, t(".#{slide[:key]}_title"), class: "flex min-h-[2.2em] items-end font-serif text-[2rem] font-normal leading-[1.1] tracking-[-0.01em] text-content text-balance sm:text-4xl lg:min-h-0") %>
            <p class="onb-body mt-3 min-h-[5.25rem] text-base leading-relaxed text-content-subtle lg:min-h-0"><%= t(".#{slide[:key]}_body") %></p>
          </div>
        </div>
      </section>
    <% end %>
  </div>

  <%# Bottom bar: Back/Next, then account actions on the last slide %>
  <footer class="mx-auto w-full max-w-5xl px-6 pb-5 pt-2 lg:px-10">
    <div class="mx-auto max-w-sm lg:ml-auto lg:mr-0 lg:max-w-md" data-onboarding-target="tourBar">
      <div class="flex items-center gap-3">
        <button type="button" class="btn-secondary h-12 justify-center px-5 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" style="display: none" data-onboarding-target="back" data-action="onboarding#previous" disabled>
          <%= t(".back") %>
        </button>
        <button type="button" class="btn-primary h-12 flex-1 justify-center text-base cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:scale-[0.98] transition" data-onboarding-target="next" data-action="onboarding#next">
          <%= t(".next") %>
        </button>
      </div>
    </div>

    <div class="mx-auto hidden max-w-sm lg:ml-auto lg:mr-0 lg:max-w-md" data-onboarding-target="finalBar">
      <%= link_to t(".create_account"), new_user_registration_path, class: "btn-primary h-12 w-full justify-center text-base focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:scale-[0.98] transition" %>
      <p class="mt-3 text-center text-sm text-content-subtle">
        <%= t(".have_account") %>
        <%= link_to t(".sign_in"), new_user_session_path, class: "rounded font-semibold text-primary underline decoration-primary/30 underline-offset-4 hover:text-accent hover:decoration-accent/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" %>
      </p>
    </div>
  </footer>
</div>
