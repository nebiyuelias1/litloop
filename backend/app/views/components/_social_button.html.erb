<%#
  Social Login Button Component (LINE & Telegram)
  Locals:
    - provider: Symbol/String (:line, :telegram)
    - url: String (destination URL for LINE)
    - telegram_bot: String (ENV['TELEGRAM_BOT_NAME'])
    - telegram_auth_url: String (telegram_login_callback_url)
    - classes: String
%>

<%
  provider ||= :line
  url ||= "#"
  telegram_bot ||= ENV['TELEGRAM_BOT_NAME']
  telegram_auth_url ||= "#"
  classes ||= ""
%>

<% if provider.to_sym == :line %>
  <%= link_to url, class: ["btn border-0 font-medium text-sm h-[40px] min-h-[40px] rounded-xl flex items-center justify-center gap-2.5 shadow-xs hover:opacity-90 active:scale-[0.98] transition-all w-full text-white", classes].join(" "), style: "background-color: #06C755; color: #ffffff;" do %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 flex-shrink-0">
      <path d="M19.952 12.417c0-4.28-4.29-7.763-9.567-7.763-5.276 0-9.567 3.483-9.567 7.763 0 3.838 3.403 7.052 8 7.652.311.067.736.205.844.472.097.242.063.622.031.867l-.136.819c-.042.242-.193.946.828.516 1.022-.43 5.512-3.245 7.52-5.553h-.001c1.387-1.521 2.048-3.065 2.048-4.773z" />
    </svg>
    <span>Log in with LINE</span>
  <% end %>
<% elsif provider.to_sym == :telegram %>
  <% if hotwire_native_app? %>
    <%# The widget's popup-based auth can't complete inside the native apps:
        popups and cross-origin redirects are routed to the external browser,
        whose cookies never reach the app's WebView. So navigate to Telegram's
        OAuth page in the external browser instead, and relay the signed result
        back into the app (deep link / handoff + polling) — see
        TelegramLoginController#native_return. %>
    <% telegram_auth_state = register_telegram_auth_state! %>
    <% if telegram_auth_state && ENV["TELEGRAM_BOT_TOKEN"].to_s.split(":").first.present? %>
      <%= button_tag type: "button",
                     class: ["btn border-0 font-medium text-sm h-[40px] min-h-[40px] rounded-xl flex items-center justify-center gap-2.5 shadow-xs hover:opacity-90 active:scale-[0.98] transition-all w-full text-white", classes].join(" "),
                     style: "background-color: #229ED9; color: #ffffff;",
                     data: {
                       controller: "telegram-native-login",
                       action: "click->telegram-native-login#open",
                       telegram_native_login_auth_url_value: telegram_oauth_url(state: telegram_auth_state),
                       telegram_native_login_poll_url_value: telegram_login_poll_path
                     } do %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" fill="currentColor" class="w-5 h-5 flex-shrink-0">
          <path d="M446.7 98.6l-67.6 318.8c-5.2 22.9-18.8 28.6-37.9 17.8l-104.8-77.1-50.5 48.5c-5.6 5.6-10.2 10.2-20.9 10.2l7.4-106.7 194.2-175.5c8.4-7.4-1.8-11.5-13-4.1L117.8 271.9 14.4 238.8c-22.4-7-22.8-22.4 4.7-33.1L412.4 66.7c18.7-6.8 35 4.1 34.3 31.9z" />
        </svg>
        <span>Log in with Telegram</span>
      <% end %>
    <% end %>
  <% elsif telegram_bot.present? %>
    <%# The widget iframe can't be styled from outside, but the embed supports
        min_width/max_width attributes that pin its button width. A Stimulus
        controller measures this slot and injects the widget with min = max, so
        the button fills it exactly (NEB-100). %>
    <div class="w-full h-[40px]"
         data-controller="telegram-widget"
         data-telegram-widget-bot-value="<%= telegram_bot %>"
         data-telegram-widget-auth-url-value="<%= telegram_auth_url %>"></div>
  <% end %>
<% end %>
