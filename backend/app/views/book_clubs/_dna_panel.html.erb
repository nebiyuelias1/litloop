<%#
  Literature DNA tab: visual-first board. Every number on it is derived in
  Ruby from the club's own data; the model only contributes the (collapsed)
  commentary and, when it succeeds, one chart image rendered by its code in
  Otari's sandbox. Generate/Regenerate is owner/club-admin only.

  Locals:
    - club: BookClub
    - past_count: Integer (past reads count)
    - can_manage_dna: Boolean
%>
<section data-club-tabs-target="panel" data-tab="dna" hidden class="pt-5">
  <% dna = club.literature_dna %>
  <% if dna.present? %>
    <% dataset = dna["dataset"] || {} %>
    <% countries = dataset["countries"] || {} %>

    <%# ---- Headline stats (deterministic, Ruby-derived) -------------------- %>
    <div class="mb-4 grid grid-cols-3 gap-2">
      <% stats = {
        t("dna_stat_reads", default: "reads<br>finished") => dataset.dig("reads", "past"),
        t("dna_stat_countries", default: "countries<br>read") => countries.size,
        t("dna_stat_members", default: "club<br>members") => dataset.dig("club", "member_count"),
        t("dna_stat_turnout", default: "avg<br>attendance") => dataset.dig("engagement", "avg_turnout") || t("none_word", default: "–"),
        t("dna_stat_questions", default: "questions<br>asked") => dataset.dig("discussion", "total"),
        dataset.dig("pages", "avg").present? ? t("dna_stat_pages", default: "avg<br>pages") : t("dna_stat_tags", default: "themes<br>read") =>
          dataset.dig("pages", "avg").present? ? dataset.dig("pages", "avg") : dataset.dig("tags").to_a.size
      } %>
      <% stats.each do |label, value| %>
        <div class="rounded-2xl border border-border bg-surface p-2.5 shadow-card text-center">
          <div class="text-xl font-black leading-none text-accent"><%= value %></div>
          <div class="mt-1 text-[10px] leading-tight text-content-subtle"><%= label.html_safe %></div>
        </div>
      <% end %>
    </div>

    <%# ---- World map (deterministic shading) ------------------------------- %>
    <% if countries.any? %>
      <article class="rounded-3xl border border-border bg-surface p-4 shadow-card">
        <h3 class="mb-2 text-base font-bold text-content">
          <%= t("dna_countries_title", default: "Where these stories come from") %>
        </h3>
        <div class="rounded-2xl border border-border bg-background p-3">
          <%= render "book_clubs/dna_map", countries: countries %>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
          <% countries.each do |code, info| %>
            <span data-dna-country="<%= code %>" title="<%= info["titles"].to_a.join(" · ") %>"
              class="inline-flex items-center gap-1 rounded-full border border-border bg-background px-2.5 py-1 text-xs text-content">
              <%= info["flag"] %> <%= info["name"] %>
              <span class="font-bold text-accent"><%= info["count"] %></span>
            </span>
          <% end %>
        </div>
      </article>
    <% end %>

    <%# ---- Sandbox-rendered chart (visual only; no plumbing story) --------- %>
    <% chart = dna["charts"] %>
    <% if chart.present? %>
      <article class="mt-4 rounded-3xl border border-border bg-surface p-4 shadow-card">
        <h3 class="mb-2 text-base font-bold text-content">
          <%= t("dna_ai_chart_title", default: "✨ Chart rendered by the model's own code in Otari's sandbox") %>
        </h3>
        <img src="<%= chart["data_uri"] %>" alt="<%= t("dna_ai_chart_alt", default: "Chart generated from the club's verified stats" ) %>"
          class="mx-auto max-w-full rounded-xl border border-border bg-white" loading="lazy" width="720" height="480">
      </article>
    <% end %>

    <%# ---- Charts ----------------------------------------------------------- %>
    <div class="mt-4">
      <%= render "book_clubs/dna_charts",
            tags: dataset["tags"] || {},
            regions: dataset["regions"] || {},
            months: dataset["months"] || {},
            engagement: dataset["engagement"] || {},
            discussion: dataset["discussion"] || {},
            weekday: dataset["weekday"] || {},
            time_of_day: dataset["time_of_day"] || {},
            locations: dataset["locations"] || {},
            cadence_days: dataset["cadence_days"] %>
    </div>

    <%# ---- AI commentary: collapsed by default ------------------------------ %>
    <% narrative = dna["narrative"] || {} %>
    <% has_voice = narrative["identity"].present? || narrative["signatures"].to_a.any? || narrative["recommendation"].present? %>
    <% if has_voice %>
      <details class="mt-4 rounded-2xl border border-dashed border-border bg-surface p-3">
        <summary class="cursor-pointer select-none text-xs font-semibold text-content">
          💬 <%= t("dna_commentary", default: "The AI's commentary on this DNA") %>
        </summary>
        <div class="mt-2">
          <% if narrative["identity"].present? %>
            <p class="text-sm leading-relaxed text-content"><%= narrative["identity"] %></p>
          <% end %>
          <% if narrative["signatures"].to_a.any? %>
            <div class="mt-2 flex flex-wrap gap-2">
              <% narrative["signatures"].to_a.each do |sig| %>
                <span class="rounded-full bg-accent/10 px-3 py-1 text-xs text-content" title="<%= sig["note"] %>">
                  ✦ <%= sig["title"] %>
                </span>
              <% end %>
            </div>
          <% end %>
          <% if narrative["recommendation"].present? %>
            <p class="mt-2 text-sm italic text-content"><%= narrative["recommendation"] %></p>
          <% end %>
          <% if narrative["highlights"].to_a.any? %>
            <div class="mt-2 grid grid-cols-2 gap-2 sm:grid-cols-3">
              <% narrative["highlights"].each do |hl| %>
                <div class="rounded-xl border border-border bg-background p-2">
                  <div class="text-lg font-black text-accent"><%= hl["value"] %></div>
                  <div class="text-[10px] leading-snug text-content-subtle"><%= hl["comment"].presence || hl["dataset_path"] %></div>
                </div>
              <% end %>
            </div>
          <% end %>
          <% if narrative["gaps"].to_a.any? %>
            <div class="mt-2 space-y-0.5">
              <% narrative["gaps"].each do |gap| %>
                <p class="text-xs text-content-muted">◦ <%= gap %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>

    <%# ---- Footer provenance (one quiet line) + admin regenerate ----------- %>
    <p class="mt-3 text-[11px] text-content-subtle">
      <%= t("dna_footer",
            default: "Generated %{at} · %{model} via Otari · every number on this board is verified against the club's own database",
            at: club.dna_generated_at&.strftime("%b %-d, %Y %H:%M"), model: dna["model"]) %>
      <% if can_manage_dna %>
        · <%= button_to t("dna_regenerate", default: "Regenerate"),
              generate_dna_book_club_path(club),
              method: :post,
              form_class: "inline",
              class: "text-xs underline text-accent hover:opacity-80",
              data: { turbo_confirm: t("dna_regenerate_confirm", default: "Regenerate the club's Literature DNA with AI?") } %>
      <% end %>
    </p>
  <% elsif can_manage_dna %>
    <div class="rounded-3xl border border-dashed border-border bg-surface p-8 text-center">
      <h3 class="mb-1 text-lg font-medium text-content"><%= t("dna_empty_title", default: "No Literature DNA yet") %></h3>
      <p class="mb-4 text-content-subtle">
        <%= t("dna_empty_hint", count: past_count,
              default: "Generate the club's Literature DNA: the AI reads through the %{count} past read(s) — every stat verified in Otari's code sandbox.",
              count: past_count) %>
      </p>
      <div class="flex flex-col items-center gap-2">
        <%= button_to t("dna_generate", default: "✨ Generate Literature DNA"),
              generate_dna_book_club_path(club),
              method: :post,
              class: "btn btn-primary",
              data: { turbo_confirm: t("dna_generate_confirm", default: "Generate the club's Literature DNA with AI? This runs in the background (usually under a minute).") } %>
        <span class="text-[11px] text-content-subtle"><%= t("dna_hint_model", default: "Runs on open-weight models via Otari — no content is sent beyond club statistics and book metadata.") %></span>
      </div>
    </div>
  <% else %>
    <div class="rounded-3xl border border-border bg-surface p-6 text-center text-sm text-content-subtle">
      <%= t("dna_pending_public", default: "This club hasn't generated its Literature DNA yet.") %>
    </div>
  <% end %>
</section>
