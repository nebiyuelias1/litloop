<%#
  Literature DNA tab panel: the AI narrative about this club's reading taste,
  the deterministic countries map, taste chips and the verifiable stat
  highlights. Members and visitors see the generated result; the Generate /
  Regenerate button is visible only to the owner or a club admin.

  Locals:
    - club: BookClub
    - past_count: Integer (reads so far)
    - can_manage_dna: Boolean
%>
<section data-club-tabs-target="panel" data-tab="dna" hidden class="pt-5">
  <% dna = club.literature_dna %>
  <% if dna.present? %>
    <% narrative = dna["narrative"] || {} %>
    <% dataset = dna["dataset"] || {} %>

    <article class="rounded-3xl border border-border bg-surface p-4 shadow-card">
      <%# Identity narrative %>
      <p class="text-sm leading-relaxed text-content"><%= narrative["identity"] %></p>
      <p class="mt-2 text-[11px] text-content-subtle">
        <%= t("dna_generated_by",
              default: "Generated by %{model} via Otari code execution — every stat below was verified in the sandbox",
              model: dna["model"]) %>
      </p>

      <%# Countries read → deterministic map %>
      <% countries = dataset["countries"] || {} %>
      <% if countries.any? %>
        <h3 class="mt-5 mb-2 text-base font-bold text-content">
          <%= t("dna_countries_title", default: "Where these stories come from") %>
        </h3>
        <div class="rounded-2xl border border-border bg-background p-3">
          <%= render "book_clubs/dna_map", countries: countries %>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
          <% countries.each do |code, info| %>
            <span data-dna-country="<%= code %>"
              class="inline-flex items-center gap-1 rounded-full border border-border bg-background px-2.5 py-1 text-xs text-content">
              <%= info["flag"] %> <%= info["name"] %>
              <span class="font-bold text-accent"><%= info["count"] %></span>
            </span>
          <% end %>
        </div>
      <% end %>

      <%# Verifiable stat highlights (each value was path-cited + cross-checked) %>
      <% highlights = narrative["highlights"].to_a %>
      <% if highlights.any? %>
        <h3 class="mt-5 mb-2 text-base font-bold text-content"><%= t("dna_highlights_title", default: "At a glance") %></h3>
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-3">
          <% highlights.each do |hl| %>
            <div class="rounded-2xl border border-border bg-background p-3">
              <div class="text-xl font-black text-accent"><%= hl["value"] %></div>
              <div class="text-[11px] leading-snug text-content-subtle"><%= hl["comment"].presence || hl["dataset_path"] %></div>
            </div>
          <% end %>
        </div>
      <% end %>

      <%# Signature traits %>
      <% signatures = narrative["signatures"].to_a %>
      <% if signatures.any? %>
        <h3 class="mt-5 mb-2 text-base font-bold text-content"><%= t("dna_signatures_title", default: "Signature traits") %></h3>
        <ul class="space-y-1.5">
          <% signatures.each do |sig| %>
            <li class="text-sm text-content">
              <span class="font-semibold">✦ <%= sig["title"] %></span>
              <% if sig["note"].present? %> — <span class="text-content-muted"><%= sig["note"] %></span><% end %>
            </li>
          <% end %>
        </ul>
      <% end %>

      <%# Taste tags %>
      <% tags = (dataset["tags"] || {}).first(10) %>
      <% if tags.any? %>
        <h3 class="mt-5 mb-2 text-base font-bold text-content"><%= t("dna_tags_title", default: "Recurring themes") %></h3>
        <div class="flex flex-wrap gap-2">
          <% tags.each do |name, count| %>
            <span class="rounded-full bg-accent/10 px-2.5 py-1 text-xs text-content">
              <%= name %> <span class="font-bold text-accent"><%= count %></span>
            </span>
          <% end %>
        </div>
      <% end %>

      <%# Untapped regions + recommendation %>
      <% gaps = narrative["gaps"].to_a %>
      <% rec = narrative["recommendation"] %>
      <% if gaps.any? || rec.present? %>
        <div class="mt-5 rounded-2xl border border-dashed border-border p-3">
          <% if gaps.any? %>
            <h3 class="mb-1 text-base font-bold text-content"><%= t("dna_gaps_title", default: "Untapped territory") %></h3>
            <ul class="mb-2 space-y-1 list-disc pl-5 text-sm text-content-muted">
              <% gaps.each do |gap| %><li><%= gap %></li><% end %>
            </ul>
          <% end %>
          <% if rec.present? %>
            <p class="text-sm italic text-content"><%= rec %></p>
          <% end %>
        </div>
      <% end %>

      <%# Owner/admin: regenerate + sandbox audit trail %>
      <% if can_manage_dna %>
        <div class="mt-4 flex flex-wrap items-center gap-3">
          <%= button_to t("dna_regenerate", default: "Regenerate Literature DNA"),
                generate_dna_book_club_path(club),
                method: :post,
                class: "btn btn-outline btn-sm",
                data: { turbo_confirm: t("dna_regenerate_confirm", default: "Regenerate the club's Literature DNA with AI?") } %>
          <details class="text-[11px] text-content-subtle">
            <summary class="cursor-pointer select-none"><%= t("dna_audit", default: "Sandbox audit trail") %></summary>
            <pre class="mt-2 max-h-64 overflow-auto whitespace-pre-wrap rounded-xl bg-background p-2 text-[10px] text-content-muted"><%= JSON.pretty_generate(dna.slice("model", "sandbox_calls", "generated_at")) %></pre>
          </details>
        </div>
      <% end %>

      <p class="mt-3 text-[11px] text-content-subtle">
        <%= t("dna_generated_at", default: "Generated %{at}", at: club.dna_generated_at&.strftime("%b %-d, %Y")) %>
      </p>
    </article>
  <% elsif can_manage_dna %>
    <%# Not generated yet → call to action for the owner/admin %>
    <div class="rounded-3xl border border-dashed border-border bg-surface p-8 text-center">
      <h3 class="mb-1 text-lg font-medium text-content"><%= t("dna_empty_title", default: "No Literature DNA yet") %></h3>
      <p class="mb-4 text-content-subtle">
        <%= t("dna_empty_hint", count: past_count,
              default: "Generate the club's Literature DNA: AI reads through the %{count} past read(s) — every stat verified in Otari's code sandbox.",
              count: past_count) %>
      </p>
      <div class="flex flex-col items-center gap-2">
        <%= button_to t("dna_generate", default: "✨ Generate Literature DNA"),
              generate_dna_book_club_path(club),
              method: :post,
              class: "btn btn-primary",
              data: { turbo_confirm: t("dna_generate_confirm", default: "Generate the club's Literature DNA with AI? This runs in the background (usually under a minute).") } %>
        <span class="text-[11px] text-content-subtle"><%= t("dna_hint_model", default: "Runs on open-weight models via Otari — no content is sent beyond club statistics and book metadata.") %></span>
      </div>
    </div>
  <% else %>
    <div class="rounded-3xl border border-border bg-surface p-6 text-center text-sm text-content-subtle">
      <%= t("dna_pending_public", default: "This club hasn't generated its Literature DNA yet.") %>
    </div>
  <% end %>
</section>
