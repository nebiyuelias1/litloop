<%#
  Literature DNA tab: a visual-only board. Every number is derived in Ruby
  from the club's own data; the model's only visible contribution is one
  chart image it drew with its own code in Otari's sandbox (neutral card).
  Owner/club-admin can (re)generate, within their monthly Otari budget
  (admins are exempt and see no budget line).

  Locals:
    - club: BookClub
    - past_count: Integer (past reads count)
    - can_manage_dna: Boolean
    - otari_remaining: Integer|nil (nil = exempt/unknown, no budget shown)
    - otari_quota: Integer|nil
%>
<% dna_budget_left = local_assigns[:otari_remaining].present? ? [ local_assigns[:otari_remaining].to_i, 0 ].max : nil %>
<% dna_budget_exhausted = dna_budget_left.present? && dna_budget_left <= 0 %>
<section data-club-tabs-target="panel" data-tab="dna" hidden class="pt-5">
  <% dna = club.literature_dna %>
  <% if dna.present? %>
    <% dataset = dna["dataset"] || {} %>
    <% countries = dataset["countries"] || {} %>

    <%# ---- World map -------------------------------------------------------- %>
    <% if countries.any? %>
      <article class="mb-4 rounded-2xl border border-border bg-background p-4">
        <h3 class="mb-3 text-xs font-bold uppercase tracking-wide text-content-subtle">
          <%= t("dna_countries_title", default: "Where these stories come from") %>
        </h3>
        <div class="rounded-xl border border-border bg-surface p-3">
          <%= render "book_clubs/dna_map", countries: countries %>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
          <% countries.each do |code, info| %>
            <span data-dna-country="<%= code %>" title="<%= info["titles"].to_a.join(" · ") %>"
              class="inline-flex items-center gap-1 rounded-full border border-border bg-surface px-2.5 py-1 text-xs text-content">
              <%= info["flag"] %> <%= info["name"] %>
              <span class="font-bold text-accent"><%= info["count"] %></span>
            </span>
          <% end %>
        </div>
      </article>
    <% end %>

    <%# ---- Sandbox-drawn chart (neutral; the model's visual contribution) -- %>
    <% chart = dna["charts"] %>
    <% if chart.present? %>
      <article class="mb-4 rounded-2xl border border-border bg-background p-4">
        <h3 class="mb-3 text-xs font-bold uppercase tracking-wide text-content-subtle">
          <%= t("dna_ai_chart_title", default: "The club chart") %>
        </h3>
        <img src="<%= chart["data_uri"] %>" alt="<%= t("dna_ai_chart_alt", default: "Chart generated from the club's verified stats" ) %>"
          class="mx-auto max-w-full rounded-xl border border-border bg-white" loading="lazy" width="720" height="480">
      </article>
    <% end %>

    <%# ---- The analytical board -------------------------------------------- %>
    <div class="mb-4">
      <%= render "book_clubs/dna_charts",
            tags: dataset["tags"] || {},
            regions: dataset["regions"] || {},
            languages: dataset["languages"] || {},
            engagement: dataset["engagement"] || {},
            discussion: dataset["discussion"] || {},
            weekday: dataset["weekday"] || {},
            time_of_day: dataset["time_of_day"] || {},
            locations: dataset["locations"] || {},
            cadence_days: dataset["cadence_days"],
            sequence: dataset["sequence"] || [],
            taste: dataset["taste"] || [],
            estimates: dna["estimates"],
            question_clusters: dna["question_clusters"] %>
    </div>

    <%# ---- Quiet provenance footer + admin regenerate ----------------------- %>
    <p class="mt-3 text-[11px] text-content-subtle">
      <%= t("dna_footer",
            default: "Generated %{at} · %{model} via Otari · every number on this board is verified against the club's own database",
            at: club.dna_generated_at&.strftime("%b %-d, %Y %H:%M"), model: dna["model"]) %>
      <% if can_manage_dna %>
        <% if dna_budget_exhausted %>
          · <%= t("dna_budget_exhausted", default: "monthly Otari budget used up — resets on the 1st") %>
        <% else %>
          <% if dna_budget_left.present? %>
            · <%= t("dna_budget_left", count: dna_budget_left, quota: local_assigns[:otari_quota],
                  default: "%{count} of %{quota} Otari credits left this month") %>
          <% end %>
          · <%= button_to t("dna_regenerate", default: "Regenerate"),
                generate_dna_book_club_path(club),
                method: :post,
                form_class: "inline",
                class: "text-xs underline text-accent hover:opacity-80",
                data: { turbo_confirm: t("dna_regenerate_confirm", default: "Regenerate the club's Literature DNA with AI?") } %>
        <% end %>
      <% end %>
    </p>
  <% elsif can_manage_dna %>
    <div class="rounded-2xl border border-dashed border-border bg-background p-8 text-center">
      <h3 class="mb-1 text-lg font-medium text-content"><%= t("dna_empty_title", default: "No Literature DNA yet") %></h3>
      <p class="mb-4 text-content-subtle">
        <%= t("dna_empty_hint", count: past_count,
              default: "Generate the club's Literature DNA: the AI draws its chart in the sandbox while every number below is verified against the club's own data.") %>
      </p>
      <div class="flex flex-col items-center gap-2">
        <% if dna_budget_exhausted %>
          <span class="text-sm text-content-subtle"><%= t("dna_budget_exhausted", default: "Monthly Otari budget used up — it resets on the 1st.") %></span>
        <% else %>
          <%= button_to t("dna_generate", default: "✨ Generate Literature DNA"),
                generate_dna_book_club_path(club),
                method: :post,
                class: "btn btn-primary",
                data: { turbo_confirm: t("dna_generate_confirm", default: "Generate the club's Literature DNA with AI? This runs in the background (usually under a minute).") } %>
        <% end %>
        <span class="text-[11px] text-content-subtle">
          <%= t("dna_hint_model", default: "Runs on open-weight models via Otari — no content is sent beyond club statistics and book metadata.") %>
          <% if dna_budget_left.present? %>
            · <%= t("dna_budget_left", count: dna_budget_left, quota: local_assigns[:otari_quota],
                  default: "%{count} of %{quota} Otari credits left this month") %>
          <% end %>
        </span>
      </div>
    </div>
  <% else %>
    <div class="rounded-2xl border border-border bg-background p-6 text-center text-sm text-content-subtle">
      <%= t("dna_pending_public", default: "This club hasn't generated its Literature DNA yet.") %>
    </div>
  <% end %>
</section>
