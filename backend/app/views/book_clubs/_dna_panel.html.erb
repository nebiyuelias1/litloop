<%#
  Literature DNA tab panel: visual-first analysis — deterministic world map,
  theme/region/rhythm charts, verified stat cards, one short AI narrative,
  and the visible proof of where the numbers were computed (Otari's sandbox).
  Generate/Regenerate is owner/club-admin only.

  Locals:
    - club: BookClub
    - past_count: Integer (reads so far)
    - can_manage_dna: Boolean
%>
<section data-club-tabs-target="panel" data-tab="dna" hidden class="pt-5">
  <% dna = club.literature_dna %>
  <% if dna.present? %>
    <% narrative = dna["narrative"] || {} %>
    <% dataset = dna["dataset"] || {} %>

    <%# ---- Verified stat cards (the "at a glance" numbers) ------------------ %>
    <% highlights = narrative["highlights"].to_a %>
    <% if highlights.any? %>
      <div class="mb-4 grid grid-cols-2 gap-2 sm:grid-cols-3">
        <% highlights.each do |hl| %>
          <div class="rounded-2xl border border-border bg-surface p-3 shadow-card" title="Verified at dataset path: <%= hl['dataset_path'] %>">
            <div class="text-2xl font-black text-accent"><%= hl["value"] %></div>
            <div class="text-[11px] leading-snug text-content-subtle"><%= hl["comment"].presence || hl["dataset_path"] %></div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# ---- World map (deterministic; shades = books read per country) ------ %>
    <% countries = dataset["countries"] || {} %>
    <% if countries.any? %>
      <article class="rounded-3xl border border-border bg-surface p-4 shadow-card">
        <h3 class="mb-2 text-base font-bold text-content">
          <%= t("dna_countries_title", default: "Where these stories come from") %>
        </h3>
        <div class="rounded-2xl border border-border bg-background p-3">
          <%= render "book_clubs/dna_map", countries: countries %>
        </div>
        <div class="mt-3 flex flex-wrap gap-2">
          <% countries.each do |code, info| %>
            <span data-dna-country="<%= code %>" title="<%= info["titles"].to_a.join(" · ") %>"
              class="inline-flex items-center gap-1 rounded-full border border-border bg-background px-2.5 py-1 text-xs text-content">
              <%= info["flag"] %> <%= info["name"] %>
              <span class="font-bold text-accent"><%= info["count"] %></span>
            </span>
          <% end %>
        </div>
      </article>
    <% end %>

    <%# ---- Charts: themes, regions, rhythm ---------------------------------- %>
    <div class="mt-4">
      <%= render "book_clubs/dna_charts",
            tags: dataset["tags"] || {},
            regions: dataset["regions"] || {},
            months: dataset["months"] || {} %>
    </div>

    <%# ---- The one narrative (kept short — visuals carry the rest) --------- %>
    <article class="mt-4 rounded-3xl border border-border bg-surface p-4 shadow-card">
      <% if narrative["identity"].present? %>
        <p class="text-sm leading-relaxed text-content"><%= narrative["identity"] %></p>
      <% end %>

      <% signatures = narrative["signatures"].to_a %>
      <% gaps = narrative["gaps"].to_a %>
      <% rec = narrative["recommendation"] %>
      <% if signatures.any? %>
        <div class="mt-3 flex flex-wrap gap-2">
          <% signatures.each do |sig| %>
            <span class="rounded-full bg-accent/10 px-3 py-1 text-xs text-content" title="<%= sig["note"] %>">
              ✦ <%= sig["title"] %>
            </span>
          <% end %>
        </div>
      <% end %>
      <% if gaps.any? || rec.present? %>
        <div class="mt-3 rounded-2xl border border-dashed border-border p-3">
          <% gaps.each do |gap| %>
            <p class="text-xs text-content-muted">◦ <%= gap %></p>
          <% end %>
          <% if rec.present? %>
            <p class="mt-1 text-sm italic text-content"><%= rec %></p>
          <% end %>
        </div>
      <% end %>
    </article>

    <%# ---- Proof page: where the numbers were computed ---------------------- %>
    <% sandbox = dna["sandbox_calls"].to_a %>
    <details class="mt-4 rounded-2xl border border-border bg-surface p-3">
      <summary class="cursor-pointer select-none text-xs font-semibold text-content">
        <%= t("dna_sandbox_title",
              default: "🔬 How these numbers were computed — %{n} verified sandbox run(s) on Otari",
              n: sandbox.size) %>
        <span class="ml-1 text-content-subtle">(not on this server, not in your browser)</span>
      </summary>
      <% if sandbox.any? %>
        <div class="mt-2 space-y-2">
          <% sandbox.each do |call| %>
            <pre class="max-h-40 overflow-auto whitespace-pre-wrap rounded-xl bg-background p-2 text-[10px] text-content-muted"><%= t("dna_sandbox_model", default: "Model-run code:") %>
<%= call["code"].to_s[0, 2200] %>
<%= t("dna_sandbox_stdout", default: "Its printed output:") %>
<%= call["stdout"].to_s[0, 2200] %></pre>
          <% end %>
        </div>
        <p class="mt-2 text-[11px] text-content-subtle"><%= t("dna_sandbox_note", default: "The gateway ran this Python; this app re-checked every published number against its own database before displaying it.") %></p>
      <% end %>
      <p class="mt-2 text-[11px] text-content-subtle">
        <%= t("dna_generated_at", default: "Generated %{at}", at: club.dna_generated_at&.strftime("%b %-d, %Y %H:%M")) %>
        · <%= dna["model"] %>
        <% if can_manage_dna %>
          · <%= button_to t("dna_regenerate", default: "Regenerate"),
                generate_dna_book_club_path(club),
                method: :post,
                form_class: "inline",
                class: "text-xs underline text-accent hover:opacity-80",
                data: { turbo_confirm: t("dna_regenerate_confirm", default: "Regenerate the club's Literature DNA with AI?") } %>
        <% end %>
      </p>
    </details>
  <% elsif can_manage_dna %>
    <%# Not generated yet → call to action for the owner/admin %>
    <div class="rounded-3xl border border-dashed border-border bg-surface p-8 text-center">
      <h3 class="mb-1 text-lg font-medium text-content"><%= t("dna_empty_title", default: "No Literature DNA yet") %></h3>
      <p class="mb-4 text-content-subtle">
        <%= t("dna_empty_hint", count: past_count,
              default: "Generate the club's Literature DNA: AI reads through the %{count} past read(s) — every stat verified in Otari's code sandbox.",
              count: past_count) %>
      </p>
      <div class="flex flex-col items-center gap-2">
        <%= button_to t("dna_generate", default: "✨ Generate Literature DNA"),
              generate_dna_book_club_path(club),
              method: :post,
              class: "btn btn-primary",
              data: { turbo_confirm: t("dna_generate_confirm", default: "Generate the club's Literature DNA with AI? This runs in the background (usually under a minute).") } %>
        <span class="text-[11px] text-content-subtle"><%= t("dna_hint_model", default: "Runs on open-weight models via Otari — no content is sent beyond club statistics and book metadata.") %></span>
      </div>
    </div>
  <% else %>
    <div class="rounded-3xl border border-border bg-surface p-6 text-center text-sm text-content-subtle">
      <%= t("dna_pending_public", default: "This club hasn't generated its Literature DNA yet.") %>
    </div>
  <% end %>
</section>
