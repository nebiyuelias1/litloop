<% content_for :title, @club.name %>
<% can_see_private = @club.private_info_visible_to?(current_user) %>

<div class="mx-auto max-w-2xl" data-controller="club-tabs">
  <%= render "book_clubs/hero_banner", club: @club %>
  <%= render "book_clubs/identity", club: @club, can_see_private: can_see_private %>
  <% can_manage_dna = user_signed_in? && (@club.owner == current_user || @club.book_club_members.exists?(user: current_user, role: :admin)) %>
  <%= render "book_clubs/tabs", club: @club, past_count: @past_reads.size,
        show_dna_tab: @club.dna_generated_at.present? || can_manage_dna %>

  <%# Current Reading %>  <section data-club-tabs-target="panel" data-tab="overview" class="pt-5">
    <% if @current_read %>
      <%= render "book_clubs/current_reading_card", club: @club, book_read: @current_read %>
    <% else %>
      <div class="mt-4 rounded-3xl border border-dashed border-border bg-surface p-8 text-center">
        <svg class="mx-auto mb-4 h-12 w-12 text-content-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <h3 class="mb-1 text-lg font-medium text-content"><%= t("no_active_session", default: "No active reading session") %></h3>
        <p class="mb-4 text-content-subtle"><%= t("no_active_session_hint", default: "The club admin hasn't selected a book to read yet.") %></p>
        <% if user_signed_in? && @club.owner == current_user %>
          <%= link_to t("start_new_read", default: "Start a New Read"),
          new_book_club_book_read_path(@club),
          class: "inline-flex items-center justify-center rounded-md bg-primary px-6 py-2.5 text-sm font-medium text-primary-contrast transition-colors hover:opacity-90" %>
        <% end %>
      </div>
    <% end %>

    <% other_reads = @upcoming_reads.drop(1) %>
    <% if other_reads.any? %>
      <h3 class="mb-3 mt-8 text-base font-bold text-content"><%= t("upcoming_meets", default: "Upcoming Meets") %></h3>
      <div class="space-y-4">
        <% other_reads.each do |read| %>
          <%= render "shared/book_read_card_link", book_read: read, club: @club, show_club_name: false %>
        <% end %>
      </div>
    <% end %>
  </section>

  <%= render "book_clubs/past_reads_panel", club: @club, past_reads: @past_reads %>
  <% if @club.dna_generated_at.present? || can_manage_dna %>
    <% otari_exempt = can_manage_dna && current_user.admin? %>
    <%= render "book_clubs/dna_panel", club: @club, past_count: @past_reads.size, can_manage_dna: can_manage_dna,
          otari_remaining: (OtariBudget.remaining(current_user) unless otari_exempt),
          otari_quota: (OtariBudget.monthly_quota(current_user) unless otari_exempt) %>
  <% end %>
</div>

<%# Swapped by the join/leave/request turbo streams. The container exists only on this page, so stream updates are no-ops on carousels where the replaced card already carries its own dialog - no duplicate IDs. %>
<% if user_signed_in? && @club.is_private %>
  <div id="apply_dialog_container">
    <% unless @club.has_member?(current_user) || @club.pending_request_from?(current_user) %>
      <%= render "book_clubs/apply_dialog", club: @club %>
    <% end %>
  </div>
<% end %>

<% if can_see_private %>
  <% current_user_is_admin =
    @club.book_club_members.find_by(user: current_user)&.admin? %>
  <% current_user_is_owner = @club.owner == current_user %>

  <%= render layout: "shared/dialog",
    locals: {
      id: "members_dialog",
      title: "Club Members (<span data-members-count>#{@club.members.size}</span>)".html_safe,
      box_class: "bg-surface border border-border shadow-xl rounded-2xl max-w-2xl p-6 relative"
    } do %>
    <div id="pending_requests_section">
      <% if current_user_is_owner && @club.pending_membership_requests.any? %>
        <div class="mb-6 border-b border-border pb-6">
          <h4 class="text-sm font-semibold text-content mb-4">Pending Join Requests (<span data-pending-requests-count><%= @club.pending_membership_requests.count %></span>)</h4>
          <div id="pending_requests_list" class="space-y-3">
            <% @club.pending_membership_requests.each do |request| %>
              <div id="<%= dom_id(request) %>" class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <%= render "shared/avatar",
                  user: request.user,
                  classes:
                    "w-8 h-8 bg-blue-600 text-white text-xs font-semibold ring-2 ring-white" %>
                  <span class="text-sm text-content"><%= request.user %></span>
                </div>
                <div class="flex gap-2">
                  <%= button_to "Approve",
                  approve_book_club_membership_request_path(@club, request),
                  method: :patch,
                  form: {
                    data: {
                      turbo_frame: "_top",
                    },
                  },
                  class: "btn btn-primary btn-sm" %>
                  <%= render "components/button",
                  label: "Reject",
                  type: "link",
                  url: reject_book_club_membership_request_path(@club, request),
                  variant: "negative",
                  size: "sm",
                  full_width: false,
                  data: {
                    turbo_submits_with: "Rejecting...",
                    turbo_method: :patch,
                  } %>
                </div>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <% body_content = capture do %>
      <% @club.book_club_members.includes(:user).order(role: :desc, created_at: :asc).each_with_index do |membership, row_idx| %>
        <%= render "book_club_members/member_row",
        membership: membership,
        club: @club,
        is_last: row_idx == @club.book_club_members.size - 1,
        current_user_is_admin: current_user_is_admin %>
      <% end %>
    <% end %>

    <% columns = %w[Member Role Joined] %>
    <% columns << "Actions" if current_user_is_admin %>

    <%= render "shared/table/table",
    columns: columns,
    body_content: body_content,
    hoverable: true,
    sticky_header: false,
    bordered: false,
    container: false,
    tbody_id: "members_tbody" %>
  <% end %>
<% end %>
