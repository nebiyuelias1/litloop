<%#
  Book Club Card Component
  Locals:
    - club: BookClub
%>
  <% is_member =
    if local_assigns[:joined_club_ids]
      joined_club_ids.include?(club.id)
    else
      current_user && club.has_member?(current_user)
    end %>
  <% card_class = card_class if local_assigns[:card_class] %>

  <div id="<%= dom_id(club) %>" class="w-full h-full">

    <div
      class="
        card bg-base-100 shadow-sm w-full h-full relative
        <%= card_class %>
      ">

      <figure>
        <% if club.cover_photo.attached? %>
          <%= image_tag club.cover_photo, class: "w-full h-32 object-cover" %>
        <% else %>
          <div
            class="
              w-full h-32 bg-background flex items-center justify-center text-content-muted
            ">
            <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
        <% end %>
      </figure>

      <div class="card-body">
        <!-- Club Name -->
        <div class="card-title title-sm font-bold text-content">
          <%= club.name %>
        </div>
        <!-- Club Description -->
        <p class="line-clamp-2 min-h-[38px]">
          <%= club.description.presence %>
        </p>
        <!-- Members list block -->
        <div class="flex items-center gap-2 mb-1 mt-auto">
          <% if club.private_info_visible_to?(current_user) %>
            <%= render "shared/avatar_group",
            users: club.members,
            limit: 5,
            size_classes: "w-6 h-6",
            text_size: "text-[9px]",
            container_classes: "" %>
          <% end %>
          <span class="text-xs">
            <%= t("member_count", count: club.members.count) %>
          </span>
        </div>
        <!-- Action Row -->
        <div class="card-actions justify-self-end relative z-20">
          <% if user_signed_in? && club.owner == current_user %>
            <%= link_to "Edit Club",
            edit_book_club_path(club),
            data: {
              turbo_frame: "_top",
            },
            class:
              "grow w-full btn btn-outline disabled:opacity-50 disabled:cursor-not-allowed" %>
          <% elsif club.is_private && !is_member %>
            <% if club.pending_request_from?(current_user) %>
              <%= button_to "Cancel Join Request",
              cancel_book_club_membership_request_path(
                club,
                club.membership_requests.find_by(user: current_user, status: :pending),
              ),
              method: :delete,
              form: {
                class: "grow",
                data: {
                  turbo_frame: "_top",
                },
              },
              data: {
                turbo_submits_with: "Cancelling...",
                turbo_confirm: "Are you sure you want to cancel your join request?",
              },
              class:
                "w-full btn btn-outline border-error/30 text-error hover:bg-error/10 hover:border-error/50 font-medium shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 transition-all duration-200 active:scale-[0.98] disabled:opacity-50 disabled:cursor-not-allowed" %>
            <% elsif !user_signed_in? %>
              <%= link_to "Apply to Join",
              new_user_session_path,
              data: {
                turbo_frame: "_top",
              },
              class:
                "grow w-full btn btn-primary disabled:opacity-50 disabled:cursor-not-allowed" %>
            <% else %>
              <button
                type="button"
                onclick="document.getElementById('apply_dialog_<%= club.id %>').showModal()"
                class="
                  grow w-full btn btn-primary disabled:opacity-50 disabled:cursor-not-allowed
                ">
                Apply to Join
              </button>
            <% end %>
          <% else %>
            <%= render "book_clubs/membership_toggle_button",
            club: club,
            is_member: is_member,
            join_label: t("join_club"),
            leave_label: t("joined_club"),
            joining_label: t("joining_club"),
            leaving_label: t("leaving_club"),
            join_button_class:
              "w-full btn btn-primary disabled:opacity-50 disabled:cursor-not-allowed",
            leave_button_class:
              "w-full btn btn-outline cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed",
            form_class: "grow" %>
          <% end %>
        </div>
      </div>
      <!-- Stretched link: makes the whole card clickable without wrapping
      interactive content (buttons, dialogs) inside an anchor -->
      <%= link_to book_club_path(club),
      data: { turbo_frame: "_top" },
      class: "absolute inset-0 z-10",
      aria: { label: club.name } do %>
        <span class="sr-only"><%= club.name %></span>
      <% end %>
    </div>

    <% if club.is_private && !is_member && user_signed_in? && !club.pending_request_from?(current_user) %>
      <%= render "book_clubs/apply_dialog", club: club %>
    <% end %>
  </div>
