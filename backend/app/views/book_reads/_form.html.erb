<%= form_with(model: [book_club, book_read], class: "space-y-6", data: { controller: "book-read-form" }) do |form| %>
  <% if @book_read.errors.any? %>
    <div
      id="error_explanation"
      class="bg-red-50 text-red-700 p-4 rounded-lg mb-6 border border-red-100">
      <h2 class="font-bold text-sm"><%= pluralize(@book_read.errors.count, "error") %>
        prohibited this book read from being saved:</h2>
      <ul class="list-disc pl-5 mt-2 text-xs">
        <% @book_read.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%# Selection Toggle (Only shown when creating a new record or for non-finalized poll sessions) %>
  <% poll_finalized = @book_read.poll&.finalized_at.present? %>
  <% can_toggle_selection =
    @book_read.new_record? || (@book_read.poll.present? && !poll_finalized) %>

  <% if can_toggle_selection %>
    <div class="space-y-3">
      <label class="block text-sm font-semibold text-content ml-1">What are we reading?</label>
      <% current_selection =
        params[:selection_type] ||
          (@book_read.poll.present? && !poll_finalized ? "poll" : "book") %>
      <div class="flex p-1 bg-background rounded-lg border border-border w-fit">

        <label
          data-book-read-form-target="selectionBtn"
          data-action="click->book-read-form#toggle"
          class="
            relative flex items-center px-4 py-2 rounded-md cursor-pointer transition-all
            bg-transparent
          ">
          <span class="text-sm font-bold text-content">Specific Book</span>
          <%= radio_button_tag :selection_type,
          "book",
          current_selection == "book",
          class: "hidden" %>
        </label>

        <label
          data-book-read-form-target="selectionBtn"
          data-action="click->book-read-form#toggle"
          class="
            relative flex items-center px-4 py-2 rounded-md cursor-pointer transition-all
            bg-transparent
          ">
          <span class="text-sm font-bold text-content">Poll</span>
          <%= radio_button_tag :selection_type,
          "poll",
          current_selection == "poll",
          class: "hidden" %>
        </label>
      </div>
    </div>
  <% else %>
    <%= hidden_field_tag :selection_type, "book" %>
  <% end %>

  <%# Dynamic Sections %>
  <div class="relative">
    <%# Book Selection Section %>
    <div
      id="book_selection_field"
      data-book-read-form-target="bookSection"
      class="p-4 rounded-lg border border-border bg-surface shadow-sm">
      <div
        data-controller="book-autocomplete"
        data-book-autocomplete-url-value="<%= books_search_path(format: :json) %>"
        class="relative">
        <label
          for="book_search_input"
          class="block text-sm font-medium text-content-subtle mb-2">Search for a book</label>

        <div class="relative group">
          <input
            id="book_search_input"
            type="text"
            data-book-autocomplete-target="input"
            data-action="
              keyup->book-autocomplete#performSearch
              click->book-autocomplete#performSearch
              focus->book-autocomplete#performSearch
            "
            placeholder="<%= t("type_title") %>"
            value="<%= @book_read.book&.title %>"
            autocomplete="off"
            class="
              block w-full rounded-md border-border bg-background py-2 px-3 text-sm
              text-content placeholder:text-content-muted focus:bg-surface
              focus:border-primary transition-all outline-none
            ">
        </div>

        <%= form.hidden_field :book_id, data: { book_autocomplete_target: "hidden" } %>

        <div
          data-book-autocomplete-target="results"
          class="
            hidden absolute z-50 mt-1 w-full bg-surface shadow-xl max-h-60 rounded-md
            overflow-y-auto border border-border
          ">
        </div>
      </div>
    </div>

    <%# Poll Selection Section %>
    <% if can_toggle_selection %>
      <div
        id="poll_fields"
        data-book-read-form-target="pollSection"
        class="
          hidden p-4 rounded-lg border border-border bg-surface shadow-sm space-y-4
        ">
        <%= form.fields_for :poll, (@book_read.poll || Poll.new) do |poll_form| %>
          <div class="space-y-1">
            <%= poll_form.label :text,
                            "Poll Question",
                            class: "block text-sm font-medium text-content-subtle" %>
            <%= poll_form.text_field :text,
                                 class:
                                   "block w-full rounded-md border-border bg-background py-2 px-3 text-sm text-content placeholder:text-content-muted focus:bg-surface focus:border-primary transition-all outline-none",
                                 placeholder: "e.g., Which book should we read next?" %>
          </div>

          <div class="pt-2 border-t border-border">
            <label class="block text-sm font-medium text-content-subtle mb-3">Poll Options (Books)</label>

            <div data-controller="dynamic-nested-fields" id="poll_options">
              <template data-dynamic-nested-fields-target="template">
                <%= poll_form.fields_for :poll_options, PollOption.new, child_index: "NEW_RECORD" do |po_form| %>
                  <%= render "poll_option_fields", form: po_form %>
                <% end %>
              </template>

              <div data-dynamic-nested-fields-target="container">
                <%# If new poll, start with two empty options %>
                <% if poll_form.object.new_record? && poll_form.object.poll_options.empty? %>
                  <% 2.times { poll_form.object.poll_options.build } %>
                <% end %>

                <%= poll_form.fields_for :poll_options do |po_form| %>
                  <%= render "poll_option_fields", form: po_form %>
                <% end %>
              </div>

              <button
                type="button"
                data-action="click->dynamic-nested-fields#add"
                class="
                  mt-2 inline-flex items-center px-3 py-1.5 border border-border shadow-sm text-xs
                  font-medium rounded text-content bg-surface hover:bg-background
                  focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary
                  transition-all
                ">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-3.5 h-3.5 mr-1.5">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                Add Another Option
              </button>
            </div>
          </div>

          <%= render "components/date_picker",
          form: poll_form,
          field_type: :datetime_local,
          name: :end_date,
          label: "Voting Ends On",
          min: (poll_form.object.new_record? ? Time.current : nil),
          error: poll_form.object.errors[:end_date] %>
        <% end %>
      </div>
    <% end %>
  </div>

  <%# Shared Fields %>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <%= render "components/input",
    form: form,
    field_type: :number,
    name: :max_capacity,
    label: "Max Capacity",
    placeholder: "e.g., 12",
    error: @book_read.errors[:max_capacity] %>

    <%= render "components/date_picker",
    form: form,
    field_type: :datetime_local,
    name: :meetup_time,
    label: "Meetup Time",
    min: (@book_read.new_record? ? Time.current : nil),
    error: @book_read.errors[:meetup_time] %>

    <%= render "components/input",
    form: form,
    name: :meetup_location,
    label: "Meetup Location",
    placeholder: "e.g., Starbucks",
    classes: "sm:col-span-2",
    error: @book_read.errors[:meetup_location] %>
  </div>

  <div
    class="
      flex flex-col-reverse sm:flex-row items-center justify-end gap-3 pt-6 border-t
      border-border
    ">
    <%= render "components/button",
    label: "Cancel",
    type: "link",
    url: book_club_path(@book_club),
    variant: "ghost",
    classes: "w-full sm:w-auto text-content-subtle hover:text-content" %>
    <%= render "components/button",
    label: "Schedule Read",
    type: "submit",
    variant: "primary",
    classes: "w-full sm:w-auto" %>
  </div>
<% end %>
