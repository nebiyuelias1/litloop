<%= turbo_frame_tag "book_read_rsvp" do %>
  <% past = book_read.meetup_time&.past? %>
  <% going = rsvp&.going? %>
  <% waitlisted = rsvp&.waitlisted? %>
  <% is_active = going || waitlisted %>
  <% next_status = is_active ? "cancelled" : "going" %>
  <% full = book_read.full? %>
  <% going_count ||= book_read.book_read_rsvps.going.count %>
  <% waitlisted_count ||= book_read.book_read_rsvps.waitlisted.count %>
  <% remaining = book_read.max_capacity.present? ? book_read.max_capacity - going_count : nil %>
  <%
    button_label = if is_active
      waitlisted ? t("leave_waitlist") : t("cancel_rsvp")
    else
      full ? t("join_waitlist") : t("rsvp")
    end
    confirm_msg = is_active ? (waitlisted ? t("leave_waitlist_confirm") : t("cancel_rsvp_confirm")) : nil
    is_primary = !is_active
    action_classes = "btn #{is_primary ? "btn-primary" : "btn-outline"} cursor-pointer shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 transition-all duration-200 active:scale-[0.98]"
  %>
  <% if past %>
    <div class="mx-auto max-w-4xl mt-8 bg-background/70 border border-border rounded-xl px-5 py-3 text-sm text-content-muted">
      <%= t("event_started") %>
    </div>
  <% else %>
    <div class="bg-surface border border-border shadow-xl rounded-2xl sticky bottom-16 sm:bottom-0 hotwire-native:bottom-0 z-10 mx-auto max-w-4xl mt-8 px-5 py-2.5 flex items-center justify-between gap-4">
      <div class="flex items-center gap-3 text-sm min-w-0">
        <% if is_active %>
          <span class="font-semibold <%= waitlisted ? "text-violet-700 dark:text-violet-400" : "text-content" %>">
            <%= waitlisted ? t("you_are_waitlisted") : t("you_are_going") %>
          </span>
        <% end %>
        <% if book_read.max_capacity.present? && book_club.private_info_visible_to?(current_user) %>
          <span class="truncate <%= is_active ? "hidden sm:inline text-content-muted" : "font-semibold text-content" %>"><%= t("spots_remaining", count: remaining || 0) %></span>
        <% end %>
      </div>
      <% if user_signed_in? %>
        <%= form_with url: book_club_book_read_rsvp_path(book_club, book_read), method: (rsvp ? :patch : :post), scope: :book_read_rsvp, class: "shrink-0" do |form| %>
          <%= form.hidden_field :status, value: next_status %>
          <%= form.submit button_label,
                class: action_classes,
                data: (confirm_msg ? { turbo_confirm: confirm_msg } : {}) %>
        <% end %>
      <% else %>
        <%= link_to button_label, new_user_session_path,
              class: action_classes,
              data: { turbo_frame: "_top" } %>
      <% end %>
    </div>
  <% end %>
<% end %>
