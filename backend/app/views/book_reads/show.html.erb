<% content_for :title,
"#{@book_read.book&.title || @book_read.poll&.text || t("book_read")} - #{@book_club.name}" %>
<% content_for :og_title,
"#{@book_read.book&.title || @book_read.poll&.text || t("reading_session")} | #{@book_club.name}" %>
<% content_for :og_description,
(
  if @private_info_visible
    t("og_join_session",
      club: @book_club.name,
      time: @book_read.meetup_time ? l(@book_read.meetup_time, format: :flyer) : t("tbd"),
      location: @book_read.meetup_location.presence || t("tbd"))
  else
    t("og_private_club", club: @book_club.name)
  end
) %>
<% content_for :og_url, book_club_book_read_url(@book_club, @book_read) %>
<% if @book_read.book.present? && @book_read.book.cover_image.present? %>
  <% content_for :og_image, cover_book_url(@book_read.book) %>
<% end %>

<div class="max-w-4xl mx-auto">
  <div class="bg-surface p-6 sm:p-8 rounded-3xl border border-border mb-8">
    <div class="flex flex-col md:flex-row gap-8">
      <div class="w-full md:w-1/3 shrink-0">
        <% if @book_read.book&.cover_image.present? %>
          <%= image_tag @book_read.book.cover_image,
          class: "w-full aspect-[2/3] object-cover rounded-xl border border-border shadow-sm" %>
        <% elsif @book_read.poll.present? %>
          <div
            class="
              w-full aspect-[2/3] bg-background rounded-xl flex flex-col items-center
              justify-center border border-border
            ">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-10 h-10 text-accent mb-3">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            <span class="text-accent text-xs font-semibold uppercase tracking-wider"><%= t("active_poll") %></span>
          </div>
        <% else %>
          <div
            class="
              w-full aspect-[2/3] bg-background rounded-xl flex flex-col items-center
              justify-center border border-border
            ">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="w-10 h-10 text-content-muted mb-3">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
            <span class="text-content-muted text-sm font-medium"><%= t("no_cover_available") %></span>
          </div>
        <% end %>
      </div>

      <% if @private_info_visible %>
        <%= render "book_reads/rsvp_dialog",
        book_read: @book_read,
        rsvp_records: @rsvp_records %>

        <%= render "book_reads/share_flyer_dialog",
        book_club: @book_club,
        book_read: @book_read %>
      <% end %>

      <div class="w-full md:w-2/3 flex flex-col">
        <div class="flex items-start justify-between gap-4 mb-4">
          <div class="min-w-0">
            <%= link_to book_club_path(@book_club),
            class:
              "inline-flex items-center gap-2 min-w-0 max-w-full mb-2 rounded-md transition-opacity hover:opacity-80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary",
            aria: { label: @book_club.name } do %>
              <% if @book_club.photo.attached? %>
                <%= image_tag @book_club.photo, alt: "", class: "w-7 h-7 aspect-square rounded-full object-cover shrink-0 ring-1 ring-border shadow-xs" %>
              <% else %>
                <span aria-hidden="true" class="w-7 h-7 rounded-full bg-accent/15 text-accent font-bold text-xs flex items-center justify-center shrink-0"><%= @book_club.name_initial %></span>
              <% end %>
              <span class="text-xs font-bold uppercase tracking-wider text-accent truncate"><%= @book_club.name %></span>
            <% end %>
            <h1 class="title title-lg text-content font-bold leading-tight mb-2">
              <%= @book_read.book&.title || @book_read.poll&.text || t("new_reading_session") %>
            </h1>

            <% if @book_read.book.present? %>
              <p class="text-base text-content-subtle"><%= t("by_author", author: @book_read.book.author) %></p>
            <% end %>
          </div>

          <div class="flex items-center gap-2 shrink-0">
            <% if @private_info_visible %>
              <button
                type="button"
                onclick="document.getElementById('share_flyer_dialog').showModal()"
                aria-label="<%= t("share") %>"
                title="<%= t("share") %>"
                class="
                  inline-flex items-center justify-center h-9 w-9 shrink-0 cursor-pointer
                  border border-border bg-surface text-content transition-colors
                  hover:bg-background hover:text-accent hover:border-accent
                  focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary
                  rounded-full
                ">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-4 w-4"
                  aria-hidden="true">
                  <path d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7" />
                  <path d="M16 6l-4-4-4 4" />
                  <path d="M12 2v14" />
                </svg>
              </button>
            <% end %>

            <% has_more_actions = @book_read.book.present? || (user_signed_in? && @book_club.owner == current_user) %>
            <% if has_more_actions %>
              <div class="dropdown dropdown-end">
              <button
                tabindex="0"
                role="button"
                aria-label="<%= t("more_actions") %>"
                title="<%= t("more_actions") %>"
                class="
                  inline-flex items-center justify-center h-9 w-9 shrink-0 cursor-pointer
                  border border-border bg-surface text-content transition-colors
                  hover:bg-background hover:text-accent hover:border-accent
                  focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary
                  rounded-full
                ">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2.5"
                  stroke="currentColor"
                  class="h-5 w-5"
                  aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 12h.01M12 12h.01M18 12h.01" />
                </svg>
              </button>
              <ul
                tabindex="0"
                class="
                  dropdown-content menu bg-surface border border-border rounded-xl z-[50] w-48
                  p-1.5 shadow-xl mt-2
                ">
                <% if @book_read.book.present? %>
                  <li>
                    <%= link_to book_path(@book_read.book), class: "flex items-center gap-2.5 py-2 px-3 rounded-lg text-content hover:bg-background text-sm font-medium transition-colors" do %>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        class="w-4 h-4 text-content-subtle">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
                      </svg>
                      <%= t("view_book_details") %>
                    <% end %>
                  </li>
                <% end %>

                <% if user_signed_in? && @book_club.owner == current_user %>
                  <li>
                    <%= link_to edit_book_club_book_read_path(@book_club, @book_read), class: "flex items-center gap-2.5 py-2 px-3 rounded-lg text-content hover:bg-background text-sm font-medium transition-colors" do %>
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        class="w-4 h-4 text-content-subtle">
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
                      </svg>
                      <%= t("edit_session") %>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </div>
            <% end %>
          </div>
        </div>
        <% if @private_info_visible %>
          <button
            onclick="document.getElementById('rsvp_dialog').showModal()"
            class="
              group w-full text-left hover:opacity-80 transition-opacity focus:outline-none
              cursor-pointer focus-visible:ring-2 focus-visible:ring-primary rounded-md mb-6
            ">
            <div
              class="
                flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2
              ">
              <div class="flex items-center gap-2 text-xs text-content">
                <%= render "shared/avatar",
                user: @book_read.host,
                classes:
                  "w-6 h-6 ring-2 ring-surface bg-primary text-primary-contrast text-[9px] font-semibold" %>
                <span><%= t("hosted_by_html", host: tag.span(@book_read.host.to_s, class: "font-semibold")) %></span>
              </div>
              <div class="flex items-center gap-1.5">
                <%= render "book_read_rsvps/rsvp_users",
                rsvp_users: @rsvp_users,
                waitlisted_count: @waitlisted_count %>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="2"
                  stroke="currentColor"
                  class="w-3.5 h-3.5 text-content-muted transition-transform group-hover:translate-x-0.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                </svg>
              </div>
            </div>
          </button>
        <% else %>
          <div class="flex items-center gap-2 text-xs text-content mb-6">
            <%= render "shared/avatar",
            user: @book_read.host,
            classes:
              "w-6 h-6 ring-2 ring-surface bg-primary text-primary-contrast text-[9px] font-semibold" %>
            <span><%= t("hosted_by_html", host: tag.span(@book_read.host.to_s, class: "font-semibold")) %></span>
          </div>
        <% end %>

        <%# Meetup Details Inset Panel (The Circulating Library Stamped Well) %>
        <%= render "book_reads/meetup_details",
        book_club: @book_club,
        book_read: @book_read,
        private_info_visible: @private_info_visible,
        rsvp_users: @rsvp_users,
        waitlisted_count: @waitlisted_count %>

        <% if @book_read.book&.description.present? %>
          <div class="mb-8">
            <h3 class="title title-sm text-content font-bold mb-3"><%= t("about_the_book") %></h3>
            <%= render "shared/collapsible_text",
            text: @book_read.book.description,
            max_lines: 6,
            classes: "text-content-subtle leading-relaxed" %>
          </div>
        <% end %>

      </div>
    </div>
  </div>

  <% if @book_read.poll.present? && @private_info_visible %>
    <%= render "book_reads/section_nav",
    poll_active: @book_read.poll.active? && @book_read.poll.finalized_at.blank?,
    question_count: @discussion_questions.where.not(id: nil).size %>
  <% end %>

  <% if @book_read.poll.present? && @private_info_visible %>
    <% poll = @book_read.poll %>
    <% finalized = poll.finalized_at.present? %>
    <% poll_active = poll.active? %>

    <div id="poll_section" class="bg-surface p-6 sm:p-8 rounded-3xl border border-border mb-8 scroll-mt-28">
      <div class="flex items-center justify-between gap-4 mb-5">
        <div class="flex items-center gap-3">
          <h2 class="title text-title text-content font-bold"><%= t("poll") %></h2>
          <% if finalized %>
            <span
              class="
                inline-flex items-center px-2 py-0.5 rounded-lg text-xs font-medium
                bg-green-100 text-green-800 border border-green-200
              ">
              <svg
                class="-ml-0.5 mr-1.5 h-2 w-2 text-green-400"
                fill="currentColor"
                viewBox="0 0 8 8">
                <circle cx="4" cy="4" r="3" />
              </svg>
              <%= t("finalized_book_selected") %>
            </span>
          <% elsif poll_active %>
            <span
              class="
                inline-flex items-center px-2 py-0.5 rounded-lg text-xs font-medium
                bg-accent/15 text-accent border border-accent/40
              ">
              <svg
                class="-ml-0.5 mr-1.5 h-2 w-2 text-accent"
                fill="currentColor"
                viewBox="0 0 8 8">
                <circle cx="4" cy="4" r="3" />
              </svg>
              <%= t("active_poll") %>
            </span>
          <% end %>
        </div>

        <div class="flex items-center gap-2">
          <% is_authorized_to_finalize = user_signed_in? && @book_club.owner == current_user %>
          <% if !finalized && !poll_active && is_authorized_to_finalize %>
            <%= link_to t("finalize_poll"),
            finalize_book_club_book_read_path(@book_club, @book_read),
            class:
              "inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-lg border border-border bg-background text-content hover:bg-surface transition-colors" %>
          <% end %>
          <%
            poll_share_url = "#{request.base_url}#{book_club_book_read_path(@book_club, @book_read, anchor: "poll_section")}"
            poll_share_title = @book_read.book&.title.presence || poll.text || t("poll", default: "Poll")
          %>
          <%= render "shared/share_button", url: poll_share_url, title: poll_share_title, label: t("share_poll") %>
        </div>
      </div>

      <% if finalized %>
        <details class="group">
          <summary
            class="
              flex items-center justify-between cursor-pointer list-none text-content-subtle
              hover:text-content transition-colors
            ">
            <div class="flex items-center gap-2">
              <svg
                class="w-4 h-4 transition-transform group-open:rotate-90"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7" />
              </svg>
              <span class="text-sm font-medium"><%= t("poll_chosen_hint") %></span>
            </div>
          </summary>
          <div class="mt-6 pt-6 border-t border-border">
            <p class="text-content-subtle mb-6"><%= poll.text %></p>
            <%= render "polls/vote_results", poll: poll, current_user: current_user %>
            <p class="mt-8 text-xs text-content-muted italic text-center"><%= t("voting_concluded", datetime: l(poll.finalized_at, format: :long)) %></p>
          </div>
        </details>
      <% else %>
        <p class="text-content-subtle mb-6"><%= poll.text %></p>
        <% user_has_voted =
          user_signed_in? && poll.poll_votes.exists?(user_id: current_user.id) %>
        <div id="poll_voting" class="scroll-mt-28">
          <% if user_has_voted || !poll_active %>
            <%= render "polls/vote_results", poll: poll, current_user: current_user %>
          <% else %>
            <%= render "polls/vote_form",
            poll: poll,
            book_club: @book_club,
            book_read: @book_read %>
          <% end %>
        </div>
        <% voting_datetime = poll.end_date ? l(poll.end_date, format: :long) : "" %>
        <p class="mt-8 text-xs text-content-muted italic text-center">
          <%= poll_active ? t("voting_ends_on", datetime: voting_datetime) : t("voting_ended_on", datetime: voting_datetime) %>
        </p>
      <% end %>
    </div>
  <% elsif @book_read.poll.present? %>
    <div class="bg-surface p-6 sm:p-8 rounded-3xl border border-border mb-8">
      <h2 class="title text-title text-content font-bold"><%= t("poll") %></h2>
      <p class="text-content-subtle text-sm mt-4"><%= t("private_club_join_poll") %></p>
    </div>
  <% end %>
  <!-- Discussion Questions Section -->
  <% if @private_info_visible %>
    <div id="discussion_section" class="bg-surface p-6 sm:p-8 rounded-3xl border border-border scroll-mt-28">
      <div class="flex items-center justify-between gap-4 mb-6">
        <div class="flex items-center gap-3">
          <h2 class="title text-title text-content font-bold"><%= t("discussion_questions") %></h2>
          <span class="rounded-full bg-accent/15 px-2 py-0.5 text-[10px] font-bold text-accent">
            <%= @discussion_questions.where.not(id: nil).size %>
          </span>
        </div>
        <%
          discussion_share_url = "#{request.base_url}#{book_club_book_read_path(@book_club, @book_read, anchor: "discussion_section")}"
        %>
        <%= render "shared/share_button",
        url: discussion_share_url,
        title: "#{t("discussion_questions")} — #{@book_club.name}",
        label: t("share_questions") %>
      </div>

      <% if user_signed_in? %>
        <div data-controller="discussion-composer" class="mb-8">
          <button
            type="button"
            data-discussion-composer-target="trigger"
            data-action="discussion-composer#open"
            class="
              w-full flex items-center gap-3 rounded-xl border border-border
              bg-background px-4 py-2.5 text-left text-sm text-content-muted
              hover:bg-surface hover:border-content-muted/40 transition-colors
              focus:outline-none focus:ring-2 focus:ring-primary/40
            ">
            <%= render "shared/avatar",
            user: current_user,
            classes: "w-7 h-7 ring-1 ring-border bg-primary text-primary-contrast text-[10px] font-semibold" %>
            <span class="flex-1"><%= t("ask_question") %></span>
            <svg
              class="w-4 h-4 text-content-muted"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10" />
            </svg>
          </button>

          <div class="hidden mt-4" data-discussion-composer-target="form">
            <%= render partial: "discussion_questions/form",
            locals: {
              book_club: @book_club,
              book_read: @book_read,
              discussion_question: @new_discussion_question,
            } %>
          </div>
        </div>
      <% end %>

      <%= turbo_stream_from @book_read, :discussion_questions %>

      <div id="discussion_questions_list" class="space-y-5">
        <% @discussion_questions.where.not(id: nil).each do |question| %>
          <%= render partial: "discussion_questions/discussion_question",
          locals: {
            discussion_question: question,
          } %>
        <% end %>
      </div>

      <div id="no_discussion_questions_wrapper">
        <% if @discussion_questions.where.not(id: nil).empty? %>
          <%= render partial: "discussion_questions/no_questions" %>
        <% end %>
      </div>
    </div>
  <% else %>
    <div class="bg-surface p-6 sm:p-8 rounded-3xl border border-border">
      <h2 class="title text-title text-content font-bold"><%= t("discussion_questions") %></h2>
      <p class="text-content-subtle text-sm mt-4"><%= t("private_club_join_discussion") %></p>
    </div>
  <% end %>

  <% unless @private_info_visible && user_signed_in? && current_user == @book_read.host %>
    <%= render "book_reads/rsvp",
    book_club: @book_club,
    book_read: @book_read,
    rsvp: @rsvp,
    going_count: @rsvp_users.size,
    waitlisted_count: @waitlisted_count %>
  <% end %>
</div>
