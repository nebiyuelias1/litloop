<!DOCTYPE html>
<html data-theme="silk" <%= "data-hotwire-native" if hotwire_native_app? %>>
  <head>
    <title><%= content_for?(:title) ? "#{content_for(:title)} - #{app_name}" : app_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Open Graph / Social Link Preview Meta Tags %>
    <meta property="og:site_name" content="<%= app_name %>">
    <meta property="og:type" content="<%= content_for(:og_type) || 'website' %>">
    <meta
      property="og:title"
      content="<%= content_for(:og_title) || content_for(:title) || app_name %>">
    <meta
      property="og:description"
      content="<%= content_for(:og_description) || "Join us on #{app_name} for book reads and discussions!" %>">
    <meta
      property="og:url"
      content="<%= content_for(:og_url) || request.original_url %>">
    <% if content_for?(:og_image) %>
      <meta property="og:image" content="<%= content_for(:og_image) %>">
      <meta name="twitter:image" content="<%= content_for(:og_image) %>">
    <% end %>
    <meta name="twitter:card" content="summary_large_image">
    <meta
      name="twitter:title"
      content="<%= content_for(:og_title) || content_for(:title) || app_name %>">
    <meta
      name="twitter:description"
      content="<%= content_for(:og_description) || "Join us on #{app_name} for book reads and discussions!" %>">

    <%= tag.meta name: "current-user-id", content: current_user&.id %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Queue flash toasts until the toast controller defines window.toast %>
    <% if flash[:toast].present? || notice.present? || alert.present? %>
      <script>
        window.showToast = function(message, options) {
          var attempts = 0;
          // A navigation abandons this page's pending queue: without this, a
          // retry that hasn't fired yet would toast the old page's message on
          // the destination page.
          document.addEventListener("turbo:before-visit", function cancel() {
            attempts = Number.MAX_SAFE_INTEGER;
          }, { once: true });
          (function fire() {
            if (typeof window.toast === "function") {
              window.toast(message, options);
            } else if (attempts++ < 100) {
              setTimeout(fire, 50);
            }
          })();
        };
      </script>
    <% end %>

    <%# Automatically trigger toast notifications from Rails flash messages %>
    <% if flash[:toast].present? %>
      <% toast_data =
        flash[:toast].is_a?(Hash) ? flash[:toast].with_indifferent_access : {} %>
      <script>
        document.addEventListener('turbo:load', function() {
          showToast('<%= j toast_data[:message] %>', {
            type: '<%= toast_data[:type] || "default" %>',
            description: '<%= j toast_data[:description].to_s %>'
          });
        }, { once: true });
      </script>
    <% end %>

    <% if notice.present? %>
      <script>
        document.addEventListener('turbo:load', function() {
          showToast('<%= j notice %>', {
            type: 'success'
          });
        }, { once: true });
      </script>
    <% end %>

    <% if alert.present? %>
      <script>
        document.addEventListener('turbo:load', function() {
          showToast('<%= j alert %>', {
            type: 'error'
          });
        }, { once: true });
      </script>
    <% end %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= if hotwire_native_app?
      stylesheet_link_tag "native", "data-turbo-track": "reload"
    end %>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        if (window.Telegram && window.Telegram.WebApp && window.Telegram.WebApp.initData) {
          if (!sessionStorage.getItem('telegram_login_attempted')) {
            sessionStorage.setItem('telegram_login_attempted', 'true');

            const initData = window.Telegram.WebApp.initData;
            window.location.href = '/telegram_mini_app/login?' + initData;
          }
        }
      });
    </script>
    <%= javascript_importmap_tags %>
  </head>

  <body
    class="bg-background min-h-screen text-content flex flex-col font-sans"
    data-controller="timezone">
    <%= render "shared/navbar" %>

    <main class="flex-1 w-full pb-16 sm:pb-0 hotwire-native:pb-0">
      <%= render "shared/toast_container" %>
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <%= yield %>
      </div>
    </main>

    <%= render "shared/footer" %>
    <%= render("shared/bottom_nav") if show_bottom_nav? %>
  </body>
</html>
