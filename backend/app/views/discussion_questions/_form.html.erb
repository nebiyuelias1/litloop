<%= content_tag :div,
id: (discussion_question.new_record? ? "new_discussion_question_form" : dom_id(discussion_question)),
class: "rounded-xl border border-border bg-background p-4 transition-colors focus-within:border-primary",
data: (discussion_question.new_record? ? { discussion_composer_target: "form" } : {}) do %>
  <%
    needs_confirm ||= false
    form_data = if discussion_question.new_record?
                  { controller: "reset-form", action: "turbo:submit-end->reset-form#reset" }
                elsif needs_confirm
                  { action: "submit->discussion-question#confirmUpdate" }
                else
                  {}
                end
  %>
  <%= form_with model: [book_club, book_read, discussion_question],
      class: "flex flex-col gap-3",
      data: form_data do |form| %>
    <% if discussion_question.errors.any? %>
      <div class="bg-red-50 text-red-700 p-3 rounded-lg border border-red-200 text-sm">
        <ul class="list-disc list-inside ml-4">
          <% discussion_question.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form.text_area :content,
    rows: 3,
    required: true,
    data: (discussion_question.new_record? ? { discussion_composer_target: "textarea" } : {}),
    class:
      "w-full rounded-lg border border-border bg-surface text-content text-sm leading-relaxed focus:ring-2 focus:ring-primary/20 focus:border-primary block p-3 placeholder:text-content-muted resize-y #{'border-red-300 focus:border-red-500 focus:ring-red-500 bg-red-50' if discussion_question.errors.any?}",
    placeholder: t("ask_question") %>

    <div class="flex justify-end gap-2">
      <% if discussion_question.new_record? %>
        <button
          type="button"
          data-action="discussion-composer#close"
          class="
            px-4 py-2 rounded-lg text-sm font-medium text-content-subtle
            hover:text-content transition-colors cursor-pointer
          ">
          <%= t("cancel") %>
        </button>
      <% else %>
        <button
          type="button"
          data-action="discussion-question#cancel"
          class="
            px-4 py-2 rounded-lg text-sm font-medium text-content-subtle
            hover:text-content transition-colors cursor-pointer
          ">
          <%= t("cancel") %>
        </button>
      <% end %>

      <%= form.button class: "inline-flex items-center justify-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold text-primary-contrast bg-primary hover:bg-primary/90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary transition-colors disabled:opacity-60 disabled:cursor-not-allowed",
      data: {
        turbo_submits_with: (discussion_question.new_record? ? t("posting") : t("updating")),
      } do %>
        <%= discussion_question.new_record? ? t("post_question") : t("update_question") %>
      <% end %>
    </div>
  <% end %>
<% end %>
