<% content_for :title, t("titles.sign_up") %>
<div class="min-h-[80vh] flex items-center justify-center py-4 sm:py-10">
  <div class="w-full max-w-md bg-transparent sm:bg-surface shadow-none sm:shadow-xl rounded-none sm:rounded-2xl p-0 sm:p-8 border-0 sm:border sm:border-border/60 transition-all">
    <div class="text-center mb-6">
      <div class="mx-auto w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 7.5v3m0 0v3m0-3h3m-3 0h-3m-2.25-4.125a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM4 19.235v-.11a6.375 6.375 0 0112.75 0v.109A12.318 12.318 0 0110.374 21c-2.331 0-4.512-.645-6.374-1.766z" />
        </svg>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-content tracking-tight">Create your account</h2>
      <p class="mt-1.5 text-xs sm:text-sm text-content-subtle">Start your free account — join us today.</p>
    </div>

    <% if flash.any? %>
      <% flash.each do |name, msg| %>
        <div class="mb-4 p-3.5 rounded-xl text-xs sm:text-sm font-medium flex items-center gap-2.5 shadow-xs <%= name.to_s == 'alert' || name.to_s == 'error' ? 'alert alert-error text-error-content' : 'alert alert-info text-info-content' %>">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span><%= msg %></span>
        </div>
      <% end %>
    <% end %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { data: { turbo: false }, class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= render "components/input",
                 form: f,
                 field_type: :text,
                 name: :name,
                 label: "Full Name",
                 placeholder: "John Doe",
                 autofocus: true,
                 autocomplete: "name",
                 required: true,
                 icon: '<svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>' %>

      <%= render "components/input",
                 form: f,
                 field_type: :email,
                 name: :email,
                 label: "Email address",
                 placeholder: "name@example.com",
                 autocomplete: "email",
                 required: true,
                 icon: '<svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>' %>

      <%= render "components/input",
                 form: f,
                 field_type: :password,
                 name: :password,
                 label: "Password",
                 placeholder: "••••••••",
                 autocomplete: "new-password",
                 required: true,
                 hint: (@minimum_password_length ? "(#{@minimum_password_length} characters minimum)" : nil),
                 toggle_password: true,
                 icon: '<svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>' %>

      <%= render "components/input",
                 form: f,
                 field_type: :password,
                 name: :password_confirmation,
                 label: "Confirm password",
                 placeholder: "••••••••",
                 autocomplete: "new-password",
                 required: true,
                 toggle_password: true,
                 icon: '<svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>' %>

      <div class="pt-2">
        <%= render "components/button",
                   label: "Sign up",
                   type: "submit",
                   variant: "primary",
                   size: "lg",
                   full_width: true %>
      </div>
    <% end %>

    <%= render "devise/shared/links" %>
  </div>
</div>
