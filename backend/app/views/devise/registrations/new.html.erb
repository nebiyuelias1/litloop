<% footer = capture do %>
  <p>
    <%= t("auth.sign_up.have_account") %>
    <%= link_to t("auth.sign_up.sign_in"), new_session_path(resource_name), class: "auth-link" %>
  </p>
  <p><%= link_to t("auth.see_how_it_works"), onboarding_path, class: "auth-link-quiet" %></p>
<% end %>
<%= render layout: "devise/shared/auth_page", locals: {
      title: t("auth.sign_up.title"),
      lede: t("auth.sign_up.lede"),
      footer: footer
    } do %>
  <% fields = %i[name email password password_confirmation] %>
  <%= render "devise/shared/error_messages", resource: resource, fields: fields %>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4", data: { turbo: false, controller: "submit-once", action: "submit->submit-once#lock turbo:submit-end->submit-once#unlock", submit_once_busy_label_value: t("auth.sign_up.busy") } }) do |f| %>
    <%= render "components/input",
        form: f, field_type: :text, name: :name,
        label: t("auth.fields.name"), autofocus: true, autocomplete: "name",
        required: true, required_marker: false,
        error: resource.errors.full_messages_for(:name).presence %>

    <%= render "components/input",
        form: f, field_type: :email, name: :email,
        label: t("auth.fields.email"), autocomplete: "email",
        required: true, required_marker: false,
        error: resource.errors.full_messages_for(:email).presence %>

    <%= render "components/input",
        form: f, field_type: :password, name: :password,
        label: t("auth.fields.password"), autocomplete: "new-password",
        required: true, required_marker: false, toggle_password: true,
        hint: (t("auth.fields.password_hint", count: @minimum_password_length) if @minimum_password_length),
        error: resource.errors.full_messages_for(:password).presence %>

    <%= render "components/input",
        form: f, field_type: :password, name: :password_confirmation,
        label: t("auth.fields.password_confirmation"), autocomplete: "new-password",
        required: true, required_marker: false, toggle_password: true,
        error: resource.errors.full_messages_for(:password_confirmation).presence %>

    <%= f.button t("auth.sign_up.submit"), type: "submit", data: { submit_once_target: "button" }, class: "btn-primary h-12 w-full justify-center text-base cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:scale-[0.98] transition" %>

    <% if devise_mapping.confirmable? %>
      <p class="text-center text-xs leading-relaxed text-content-muted"><%= t("auth.sign_up.confirm_note") %></p>
    <% end %>
  <% end %>
<% end %>
