<% content_for :title, t("titles.sign_in") %>
<div class="min-h-[80vh] flex items-center justify-center py-4 sm:py-10">
  <div class="w-full max-w-md bg-transparent sm:bg-surface shadow-none sm:shadow-xl rounded-none sm:rounded-2xl p-0 sm:p-8 border-0 sm:border sm:border-border/60 transition-all">
    <div class="text-center mb-6">
      <div class="mx-auto w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-3">
        <svg xmlns="http://www.w3.org/2000/svg" class="size-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
        </svg>
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-content tracking-tight">Sign in to your account</h2>
      <p class="mt-1.5 text-xs sm:text-sm text-content-subtle">Welcome back — enter your details to access your account.</p>
    </div>

    <% if flash.any? %>
      <% flash.each do |name, msg| %>
        <div class="mb-4 p-3.5 rounded-xl text-xs sm:text-sm font-medium flex items-center gap-2.5 shadow-xs <%= name.to_s == 'alert' || name.to_s == 'error' ? 'alert alert-error text-error-content' : 'alert alert-info text-info-content' %>">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span><%= msg %></span>
        </div>
      <% end %>
    <% end %>

    <%= render "devise/shared/error_messages", resource: resource %>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { data: { turbo: false }, class: "space-y-4" }) do |f| %>
      <%= render "components/input",
                 form: f,
                 field_type: :email,
                 name: :email,
                 label: "Email address",
                 placeholder: "name@example.com",
                 autofocus: true,
                 autocomplete: "email",
                 required: true,
                 icon: '<svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" /></svg>' %>

      <%= render "components/input",
                 form: f,
                 field_type: :password,
                 name: :password,
                 label: "Password",
                 placeholder: "••••••••",
                 autocomplete: "current-password",
                 required: true,
                 toggle_password: true,
                 icon: '<svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>' %>

      <% if devise_mapping.rememberable? %>
        <div class="flex flex-row items-center justify-between gap-2 pt-1">
          <%= render "components/checkbox",
                     form: f,
                     name: :remember_me,
                     label: "Remember me",
                     checked: true,
                     classes: "hotwire-native:hidden" %>

          <div class="text-sm">
            <%= link_to "Forgot password?", new_password_path(resource_name), class: "font-semibold text-primary hover:text-accent transition-colors underline-offset-4 hover:underline" %>
          </div>
        </div>
      <% end %>

      <div class="pt-2">
        <%= render "components/button",
                   label: "Log in",
                   type: "submit",
                   variant: "primary",
                   size: "lg",
                   full_width: true %>
      </div>
    <% end %>

    <div class="divider text-xs text-content-muted font-medium my-6">OR CONTINUE WITH</div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 items-center">
      <%= render "components/social_button", provider: :line, url: line_login_authorize_path %>
      <%= render "components/social_button", provider: :telegram, telegram_bot: ENV['TELEGRAM_BOT_NAME'], telegram_auth_url: telegram_login_callback_url %>
    </div>

    <%= render "devise/shared/links" %>
  </div>
</div>
