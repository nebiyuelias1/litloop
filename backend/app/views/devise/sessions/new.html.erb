<% footer = capture do %>
  <p>
    <%= t("auth.sign_in.no_account") %>
    <%= link_to t("auth.sign_in.create_account"), new_registration_path(resource_name), class: "auth-link" %>
  </p>
  <p><%= link_to t("auth.see_how_it_works"), onboarding_path, class: "auth-link-quiet" %></p>
<% end %>
<%= render layout: "devise/shared/auth_page", locals: {
      title: t("auth.sign_in.title"),
      lede: t("auth.sign_in.lede"),
      footer: footer
    } do %>
  <%= render "devise/shared/error_messages", resource: resource, fields: %i[email password] %>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4", data: { turbo: false, controller: "submit-once", action: "submit->submit-once#lock turbo:submit-end->submit-once#unlock", submit_once_busy_label_value: t("auth.sign_in.busy") } }) do |f| %>
    <%= render "components/input",
        form: f, field_type: :email, name: :email,
        label: t("auth.fields.email"), autofocus: true, autocomplete: "email",
        required: true, required_marker: false %>

    <div>
      <%= render "components/input",
          form: f, field_type: :password, name: :password,
          label: t("auth.fields.password"), autocomplete: "current-password",
          required: true, required_marker: false, toggle_password: true %>
      <p class="mt-2 text-right">
        <%= link_to t("auth.sign_in.forgot_password"), new_password_path(resource_name), class: "auth-link-quiet" %>
      </p>
    </div>

    <% if devise_mapping.rememberable? %>
      <%= render "components/checkbox", form: f, name: :remember_me, label: t("auth.sign_in.remember_me"), checked: true, classes: "hotwire-native:hidden" %>
    <% end %>

    <%= f.button t("auth.sign_in.submit"), type: "submit", data: { submit_once_target: "button" }, class: "btn-primary h-12 w-full justify-center text-base cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:scale-[0.98] transition" %>
  <% end %>

  <%# Social sign-in is off until the native flows are verified (NEB-100):
        render "components/social_button", provider: :line, url: line_login_authorize_path
        render "components/social_button", provider: :telegram %>

  <% if devise_mapping.confirmable? %>
    <p class="mt-5 text-center text-sm">
      <%= link_to t("auth.sign_in.resend_confirmation"), new_confirmation_path(resource_name), class: "auth-link-quiet" %>
    </p>
  <% end %>
<% end %>
