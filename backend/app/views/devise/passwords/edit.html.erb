<% footer = capture do %>
  <p><%= link_to t("auth.back_to_sign_in"), new_session_path(resource_name), class: "auth-link" %></p>
<% end %>
<%= render layout: "devise/shared/auth_page", locals: {
      title: t("auth.reset.title"),
      lede: (t("auth.fields.password_hint", count: @minimum_password_length) if @minimum_password_length),
      footer: footer
    } do %>
  <%= render "devise/shared/error_messages", resource: resource, fields: %i[password password_confirmation] %>
  <% if resource.errors.include?(:reset_password_token) %>
    <p class="-mt-2 mb-5 text-sm">
      <%= link_to t("auth.reset.request_new"), new_password_path(resource_name), class: "auth-link" %>
    </p>
  <% end %>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-4", data: { controller: "submit-once", action: "submit->submit-once#lock turbo:submit-end->submit-once#unlock", submit_once_busy_label_value: t("auth.reset.busy") } }) do |f| %>
    <%= f.hidden_field :reset_password_token %>

    <%= render "components/input",
        form: f, field_type: :password, name: :password,
        label: t("auth.fields.new_password"), autofocus: true, autocomplete: "new-password",
        required: true, required_marker: false, toggle_password: true,
        error: resource.errors.full_messages_for(:password).presence %>

    <%= render "components/input",
        form: f, field_type: :password, name: :password_confirmation,
        label: t("auth.fields.password_confirmation"), autocomplete: "new-password",
        required: true, required_marker: false, toggle_password: true,
        error: resource.errors.full_messages_for(:password_confirmation).presence %>

    <%= f.button t("auth.reset.submit"), type: "submit", data: { submit_once_target: "button" }, class: "btn-primary h-12 w-full justify-center text-base cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:scale-[0.98] transition" %>
  <% end %>
<% end %>
