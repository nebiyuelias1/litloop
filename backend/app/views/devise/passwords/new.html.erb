<% footer = capture do %>
  <p>
    <%= t("auth.forgot.remembered") %>
    <%= link_to t("auth.back_to_sign_in"), new_session_path(resource_name), class: "auth-link" %>
  </p>
<% end %>
<%= render layout: "devise/shared/auth_page", locals: {
      title: t("auth.forgot.title"),
      lede: t("auth.forgot.lede"),
      footer: footer
    } do %>
  <%= render "devise/shared/error_messages", resource: resource, fields: %i[email] %>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "space-y-4", data: { controller: "submit-once", action: "submit->submit-once#lock turbo:submit-end->submit-once#unlock", submit_once_busy_label_value: t("auth.forgot.busy") } }) do |f| %>
    <%= render "components/input",
        form: f, field_type: :email, name: :email,
        label: t("auth.fields.email"), autofocus: true, autocomplete: "email",
        required: true, required_marker: false,
        error: resource.errors.full_messages_for(:email).presence %>

    <%= f.button t("auth.forgot.submit"), type: "submit", data: { submit_once_target: "button" }, class: "btn-primary h-12 w-full justify-center text-base cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary active:scale-[0.98] transition" %>
  <% end %>
<% end %>
