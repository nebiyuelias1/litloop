<%#
  Errors not shown beside a field (e.g. an expired reset token).
  Locals: resource, fields (attributes the form shows as fields).
%>
<% fields = Array(local_assigns[:fields]).map(&:to_sym) %>
<% messages = resource.errors.reject { |error| fields.include?(error.attribute) }.map(&:full_message).uniq %>
<% if messages.any? %>
  <div id="error_explanation" role="alert" data-turbo-cache="false" class="mb-5 flex items-start gap-3 rounded-2xl border border-error/30 bg-error/5 px-4 py-3 text-sm text-content">
    <svg class="mt-0.5 h-5 w-5 shrink-0 text-error" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>
    <ul class="space-y-1 leading-relaxed">
      <% messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% elsif resource.errors.any? %>
  <%# Field errors only: keep the id for tests and assistive tech %>
  <p id="error_explanation" role="alert" class="sr-only"><%= t("auth.fix_fields") %></p>
<% end %>
