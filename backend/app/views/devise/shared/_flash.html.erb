<%# Inline notices/alerts; :inline_flash stops the layout's duplicate toast %>
<% messages = flash.to_hash.slice("notice", "alert").select { |_, msg| msg.is_a?(String) && msg.present? } %>
<% if messages.any? %>
  <% content_for :inline_flash, true %>
  <% messages.each do |kind, msg| %>
    <% alert = kind == "alert" %>
    <div
      role="<%= alert ? 'alert' : 'status' %>"
      class="mb-5 flex items-start gap-3 rounded-2xl border px-4 py-3 text-sm <%= alert ? 'border-error/30 bg-error/5 text-content' : 'border-primary/20 bg-primary/5 text-content' %>">
      <% if alert %>
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-error" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" /></svg>
      <% else %>
        <svg class="mt-0.5 h-5 w-5 shrink-0 text-primary" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" /></svg>
      <% end %>
      <p class="leading-relaxed"><%= msg %></p>
    </div>
  <% end %>
<% end %>
