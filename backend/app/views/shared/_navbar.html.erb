<header
  class="
    bg-background border-b border-primary sticky top-0 z-50 hotwire-native:hidden
  ">
  <nav class="container mx-auto px-4 sm:px-6 lg:px-8" aria-label="Top">
    <div class="flex h-16 items-center justify-between">
      <div class="flex items-center">
        <%= link_to root_path, class: "flex items-center gap-2 group" do %>
          <%= render "shared/logo",
          class: "h-8 w-auto text-primary group-hover:text-accent transition-colors" %>
          <!--
          <span class="title title-sm font-bold tracking-tight text-primary"><%= app_name %></span>
          -->
        <% end %>
      </div>

      <div class="ml-10 space-x-4 flex items-center">
        <% if user_signed_in? %>
          <div class="hidden sm:flex items-center gap-3">
            <span class="text-sm text-content-subtle"><%= t("welcome_message", user: current_user.to_s) %></span>
          </div>
        <% else %>
          <div class="hidden sm:flex items-center gap-3">
            <%= link_to t("sign_in"),
            new_user_session_path,
            data: {
              turbo: false,
            },
            class: "btn-secondary text-primary" %>
            <%= link_to t("sign_up"),
            new_user_registration_path,
            data: {
              turbo: false,
            },
            class: "btn-primary" %>
          </div>
        <% end %>
        <%= render "shared/language_switcher" %>

        <div class="hidden sm:block ml-2">
          <div class="dropdown dropdown-end">
            <div
              tabindex="0"
              role="button"
              class="
                btn btn-ghost btn-circle flex items-center justify-center focus:outline-none
              ">
              <svg
                class="w-6 h-6 text-primary"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </div>

            <ul
              tabindex="0"
              class="
                menu dropdown-content bg-surface border border-primary rounded-box z-50 w-56 p-2
                shadow-xl
              ">
              <% main_navigation_items.each do |item| %>
                <% is_active = is_active_nav_item?(item) %>
                <li>
                  <%= link_to item[:path], class: "flex items-center gap-3 transition-colors group/link #{is_active ? 'active font-bold text-primary' : 'text-primary'}" do %>
                    <% icon_name = is_active ? "#{item[:icon]}_solid" : item[:icon] %>
                    <%= render "shared/icons/#{icon_name}",
                    classes:
                      "w-5 h-5 transition-colors #{is_active ? "text-primary" : "text-primary group-hover/link:text-accent"}" %>
                    <%= item[:name] %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </div>
        </div>

        <%# Mobile Menu Button Placeholder - simple pure CSS or JS toggle needed for real implementation %>
        <div class="sm:hidden">
          <% unless user_signed_in? %>
            <%= link_to t("sign_in"),
            new_user_session_path,
            data: {
              turbo: false,
            },
            class: "btn-secondary text-primary" %>
          <% end %>
        </div>
      </div>
    </div>
  </nav>
</header>
