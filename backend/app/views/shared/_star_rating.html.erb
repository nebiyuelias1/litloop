<%#
  Star rating input: five native radio inputs in a fieldset, so arrow keys,
  the checked state and screen-reader semantics come from the browser.
  Unselected stars are Faded Marginalia outlines (5.2:1 on Book Page); the
  chosen star and those before it fill with Oxblood. Hovering previews a score
  on devices that can hover. All visual state is CSS on :checked/:hover; wire
  behaviour (saving) through input_data.

  Locals:
    - score: Integer, the current score 0..5 (0 = unrated)
    - legend: String, accessible name for the group (visually hidden)
    - name: String, radio group name, default "rating_score"
    - input_data: Hash, data attributes for each radio
      (e.g. { rating_target: "input", action: "change->rating#rate" })
%>
<%
  score = local_assigns[:score].to_i
  name = local_assigns[:name].presence || "rating_score"
  input_data = local_assigns[:input_data] || {}
  star_path = "M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"
%>
<% unless @star_rating_styles_rendered %>
  <% @star_rating_styles_rendered = true %>
  <style>
    .star-rating {
      display: flex;
      margin-inline: -0.375rem;
    }
    .star-rating__star {
      position: relative;
      display: inline-flex;
      padding: 0.375rem;
      border-radius: var(--radius-lg, 0.5rem);
      color: var(--color-content-muted);
      cursor: pointer;
    }
    .star-rating__star svg {
      width: 2rem;
      height: 2rem;
      fill: transparent;
      stroke: currentColor;
      stroke-width: 1.25;
      stroke-linejoin: round;
      transition:
        fill 150ms cubic-bezier(0.16, 1, 0.3, 1),
        color 150ms cubic-bezier(0.16, 1, 0.3, 1),
        transform 150ms cubic-bezier(0.16, 1, 0.3, 1);
    }
    .star-rating__star:has(input:checked),
    .star-rating__star:has(~ .star-rating__star input:checked) {
      color: var(--color-accent);
    }
    .star-rating__star:has(input:checked) svg,
    .star-rating__star:has(~ .star-rating__star input:checked) svg {
      fill: currentColor;
    }
    @media (hover: hover) {
      /* Hover previews a score: clear the current fill, then fill up to the pointer. */
      .star-rating:has(.star-rating__star:hover) .star-rating__star {
        color: var(--color-content-muted);
      }
      .star-rating:has(.star-rating__star:hover) .star-rating__star svg {
        fill: transparent;
      }
      .star-rating:has(.star-rating__star:hover) .star-rating__star:is(:hover, :has(~ .star-rating__star:hover)) {
        color: var(--color-accent);
      }
      .star-rating:has(.star-rating__star:hover) .star-rating__star:is(:hover, :has(~ .star-rating__star:hover)) svg {
        fill: currentColor;
      }
    }
    .star-rating__star:active svg {
      transform: scale(0.88);
    }
    .star-rating__star:has(input:focus-visible) {
      outline: 2px solid var(--color-primary);
      outline-offset: 0;
    }
    .star-rating:has(input:disabled) .star-rating__star {
      cursor: progress;
    }
    @media (prefers-reduced-motion: reduce) {
      .star-rating__star svg {
        transition: none;
      }
    }
  </style>
<% end %>
<fieldset class="star-rating">
  <legend class="sr-only"><%= legend %></legend>
  <% 1.upto(5) do |value| %>
    <label class="star-rating__star">
      <%= radio_button_tag name, value, score == value, id: nil, class: "sr-only", data: input_data %>
      <span class="sr-only"><%= t("shared.star_rating.stars", count: value) %></span>
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="<%= star_path %>" /></svg>
    </label>
  <% end %>
</fieldset>
