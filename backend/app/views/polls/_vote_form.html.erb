<%# Poll voting: hairline-ruled option rows on the ground; a circular control marks the selected book %>
<%= form_with url: book_club_book_read_poll_votes_path(book_club, book_read),
  method: :post,
  data: { controller: "poll-vote-form" },
  id: "poll_vote_form",
  class: "space-y-3" do %>
  <div class="divide-y divide-border">
    <% poll.poll_options.includes(:poll_votes, :book).each do |option| %>
      <label
        class="
          flex items-center justify-between gap-4 py-3.5 group cursor-pointer
          hover:bg-surface/60 transition-colors
        ">
        <div class="flex items-center gap-3.5 flex-1 min-w-0">
          <%# The checked glyph is the non-color indicator: color alone never confirms the selection %>
          <span class="relative inline-flex shrink-0 items-center justify-center">
            <%= check_box_tag "poll_option_ids[]",
            option.id,
            false,
            class:
              "w-5 h-5 rounded-full appearance-none bg-background border border-content-muted shrink-0" \
              " checked:border-primary checked:bg-primary/15" \
              " focus:ring-2 focus:ring-primary/40 group-has-[:checked]:border-primary",
            data: { poll_vote_form_target: "option", action: "poll-vote-form#toggle" } %>
            <svg aria-hidden="true" class="pointer-events-none absolute w-3 h-3 text-primary opacity-0 group-has-[:checked]:opacity-100" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
            </svg>
          </span>

          <%# Cover / title block %>
          <% if option.book.present? %>
            <div class="flex items-center gap-3 min-w-0">
              <% if option.book.cover_image.present? %>
                <%= image_tag option.book.cover_image, class: "w-10 h-14 object-cover rounded border border-border shrink-0" %>
              <% else %>
                <div class="w-10 h-14 bg-surface border border-border rounded flex items-center justify-center shrink-0">
                  <svg class="w-6 h-6 text-content-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                  </svg>
                </div>
              <% end %>
              <div class="flex flex-col min-w-0">
                <span class="font-bold text-content leading-tight group-has-[:checked]:text-primary transition-colors"><%= option.book.title %></span>
                <span class="text-xs text-content-subtle"><%= option.book.author %></span>
                <%= link_to t("view_details"), book_path(option.book), class: "text-xs font-medium text-primary hover:text-accent transition-colors mt-1 w-fit", onclick: "event.stopPropagation();" %>
              </div>
            </div>
          <% else %>
            <span class="font-bold text-content group-has-[:checked]:text-primary transition-colors"><%= option.content %></span>
          <% end %>
        </div>
      </label>
    <% end %>
  </div>

  <button
    type="submit"
    data-poll-vote-form-target="submit"
    disabled
    class="
      mt-4 px-6 py-2.5 rounded-lg text-sm font-semibold transition-colors
      text-primary-contrast bg-primary hover:bg-primary/90
      focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary
      disabled:opacity-50 disabled:cursor-not-allowed active:scale-[0.98]
    ">
    <%= t("vote") %>
  </button>
<% end %>
