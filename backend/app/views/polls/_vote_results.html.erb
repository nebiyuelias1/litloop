<%# Load the options with their votes ONCE: totals, rendering, and the winner
    all read from the same in-memory set, so a vote committed mid-request can
    never push a bar past 100% or skew the winner %>
<% options = poll.poll_options.includes(:poll_votes, :book).to_a %>
<% total_votes = options.sum { |option| option.poll_votes.size } %>
<% max_votes = options.map { |option| option.poll_votes.size }.max %>
<div class="divide-y divide-border">
  <% options.each do |option| %>
    <% votes = option.poll_votes.size %>
    <% percent = total_votes.positive? ? ((votes.to_f / total_votes) * 100).round : 0 %>
    <% user_voted = current_user.present? && option.poll_votes.any? { |vote| vote.user_id == current_user.id } %>
    <% leading = total_votes.positive? && votes == max_votes %>
    <div class="py-4 [&:first-child]:pt-0 [&:last-child]:pb-0">
      <div class="flex items-center justify-between gap-4">
        <div class="flex items-center gap-4 min-w-0">
          <% if option.book.present? %>
            <div class="flex items-center gap-3 min-w-0">
              <div class="relative w-10 h-14 bg-surface border border-border rounded overflow-hidden shrink-0">
                <%# Bookplate monogram sits beneath the image; image-fallback hides a broken img on error %>
                <%= render "shared/book_cover_fallback", book: option.book, size_class: "text-lg" %>
                <% if option.book.cover_image.present? %>
                  <%= image_tag option.book.cover_image, data: { controller: "image-fallback", action: "error->image-fallback#fail" }, class: "relative w-10 h-14 object-cover" %>
                <% end %>
              </div>
              <div class="flex flex-col min-w-0">
                <div class="flex items-center gap-2">
                  <span class="font-bold text-content leading-tight"><%= option.book.title %></span>
                  <% if user_voted %>
                    <div class="flex items-center justify-center w-5 h-5 rounded-full bg-primary text-primary-contrast shrink-0" title="<%= t("your_vote") %>">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5">
                        <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                      </svg>
                    </div>
                  <% end %>
                </div>
                <span class="text-xs text-content-subtle"><%= option.book.author %></span>
                <%= link_to t("view_details"), book_path(option.book), class: "text-xs font-medium text-primary hover:text-accent transition-colors mt-1" %>
              </div>
            </div>
          <% else %>
            <div class="flex items-center gap-3">
              <span class="font-bold text-content"><%= option.content %></span>
              <% if user_voted %>
                <div class="flex items-center justify-center w-5 h-5 rounded-full bg-primary text-primary-contrast shrink-0" title="<%= t("your_vote") %>">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-3.5 h-3.5">
                    <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" />
                  </svg>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
        <span class="text-xs font-semibold text-content-muted shrink-0 text-right">
          <%= t("votes_count", count: votes) %>
          <% if total_votes.positive? && votes.positive? %>
            <span class="ml-1 text-content-subtle"><%= number_to_percentage(percent, precision: 0) %></span>
          <% end %>
        </span>
      </div>
      <% if total_votes.positive? %>
        <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-border/40">
          <div class="h-full rounded-full <%= leading ? "bg-primary" : "bg-primary/40" %> transition-all duration-500" style="width: <%= percent %>%"></div>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
